# メンテナンス・稼働状況の情報サーバー(Strategy: 読む側は GET、書く側は認証つき WebDAV の PUT/DELETE)。
server {
    listen 8080;
    server_tokens off;
    client_max_body_size 1m;

    # アプリの確認先(MAINTENANCE_URL)。メンテナンス中(/data/maintenance.flag がある)は 503、通常は 200。
    location = /health {
        default_type application/json;
        if (-f /data/maintenance.flag) { return 503 '{"status":"maintenance"}'; }
        return 200 '{"status":"ok"}';
    }

    # コンテナの生存確認(メンテナンス中でも 200)
    location = /ping { return 200 'ok'; }

    # 通知する情報ファイル。読むのは誰でも、書き換え・削除は Basic 認証のみ。FTP は使わない。
    location /info/ {
        alias /data/info/;
        default_type application/json;
        add_header Cache-Control "no-store";
        autoindex off;

        dav_methods PUT DELETE;
        dav_access user:rw group:r all:r;
        create_full_put_path on;

        limit_except GET HEAD {
            auth_basic "maintenance";
            auth_basic_user_file /etc/nginx/htpasswd;
        }
    }

    # メンテナンス中にするフラグ。PUT で作成(中身は何でもよい)、DELETE で解除。認証必須。
    location = /maintenance.flag {
        alias /data/maintenance.flag;
        auth_basic "maintenance";
        auth_basic_user_file /etc/nginx/htpasswd;
        dav_methods PUT DELETE;
        dav_access user:rw group:r all:r;
        limit_except PUT DELETE { deny all; }
    }
}
