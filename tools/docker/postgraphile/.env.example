DOMAIN=okp-03.local
DB_IP=192.168.1.101
DB_PORT=5432
DB_APP_NAME=test_avocado
DB_APP_UID=authenticator
DB_APP_PWD=
DB_SCHEMA=tests
DB_UID=postgres
DB_PWD=

# --- 追加: リクエスト用の接続ユーザー -----------------------------------
# LOGIN NOINHERIT。tester / tester_admin / app_anonymous を GRANT 済みであること
DB_AUTH_UID=authenticator
# パスワードに記号を含む場合は URL エンコードする（@ → %40 など）
DB_AUTH_PWD=
 
# --- 追加: JWT（PocketBase の .env と同じ値をコピー） ----------------------
# PocketBase の PB_GRAPHQL_JWT_SECRET と「完全に同じ値」
PB_GRAPHQL_JWT_SECRET=
# PocketBase の PB_GRAPHQL_JWT_AUDIENCE と同じ値
PB_GRAPHQL_JWT_AUDIENCE=postgraphile
# exp 判定の許容秒数（Raspberry Pi の時刻ずれ対策）
PGL_JWT_CLOCK_TOLERANCE=30
# JWT なしのリクエストで使うロール（NOLOGIN、authenticator に GRANT 済み）
PGL_DEFAULT_ROLE=pms_anonymous