# =====================================================================
#  データベースサービス (postgresql) 設定
#  cp .env.example .env して値を設定する。.env は Git 管理外にすること。
# =====================================================================

#メイン設定
DB_UID=postgres
DB_PWD=
DB_DATA_PATH=

## メインサーバー
DB_SVR=avocado
DB_SCHEMA=stores

## テストサーバー
DB_TEST_SVR=test_avocado
DB_TEST_SCHEMA=tests

# ログイン可能（パスワードあり）。権限は持たせず、切り替え専用にする
APP_SERVICE_USER_ID=authenticator
# 強いパスワード
APP_SERVICE_USER_PWD=

# メイン環境デバッグユーザー
DEBUGGER_ID=avocado_admin
DEBUGGER_PWD=

# テスト環境デバッグユーザー
TEST_DEBUGGER_ID=tester_admin
TEST_DEBUGGER_PWD=

# アプリ切り替えユーザー
APP_OWNER_ID=app_owner
APP_ANONYMOUS=pms_anonymous
APP_USER_ID=pms_user
APP_ADMIN_ID=pms_admin
