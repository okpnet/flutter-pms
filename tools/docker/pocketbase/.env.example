# =====================================================================
#  App ログインサービス (PocketBase) 設定
#  cp .env.example .env して値を設定する。.env は Git 管理外にすること。
# =====================================================================

# --- 必須 -------------------------------------------------------------
# データ暗号化キー（32文字）。openssl rand -hex 16 で生成。初回起動前に決め、以後変更しない。
PB_ENCRYPTION_KEY=

# --- 基本 -------------------------------------------------------------
PB_VERSION=0.40.6
PB_PORT=8090
# Caddy (proxy プロファイル) 使用時は 127.0.0.1
PB_BIND=0.0.0.0
PB_APP_NAME=App
PB_APP_URL=http://localhost:8090

# --- superuser --------------------------------------------------------
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=
# true = 起動のたびに上書き / false = 初回だけ作成
PB_SUPERUSER_SYNC=true

# --- 保存先（USB SSD / NAS 推奨。SD カードに置かない） ------------------
PB_DATA_DIR=/mnt/ssd/pb/data
PB_STORAGE_DIR=/mnt/ssd/pb/storage

# --- ログイン ---------------------------------------------------------
# username,email / username
PB_IDENTITY_FIELDS=username,email
# 秒（604800 = 7日）
PB_AUTH_TOKEN_DURATION=604800
PB_PASSWORD_MIN_LENGTH=10

# --- 申請・コード -----------------------------------------------------
PB_SIGNUP_MAX_PENDING=50
PB_ACTIVATE_CODE_TTL_HOURS=72
PB_RESET_CODE_TTL_HOURS=24
PB_CODE_MAX_ATTEMPTS=5
# メール内のアプリ起動リンク（空ならリンクなし）
PB_CODE_LINK_BASE=myapp://code

# --- レート制限（同一 IP、60秒あたり） ---------------------------------
PB_RATE_LIMIT=true
PB_RATE_LIMIT_SIGNUP_PER_MIN=5
PB_RATE_LIMIT_RESET_REQUEST_PER_MIN=5
PB_RATE_LIMIT_CODE_PER_MIN=10
PB_RATE_LIMIT_LOGIN_PER_MIN=10
# Caddy 経由なら true（X-Forwarded-For を信頼）
PB_TRUSTED_PROXY=false

# --- ファイル ---------------------------------------------------------
PB_FILE_MAX_MB=100
# Caddy のリクエスト上限（PB_FILE_MAX_MB より少し大きく）
PB_PROXY_MAX_BODY=110MB
# アバター画像の最大サイズ (MB)。JPEG / PNG / WebP のみ
PB_AVATAR_MAX_MB=2

# --- GraphQL (PostGraphile) 連携 ---------------------------------------
# HS256 共通鍵。PostGraphile の jwtSecret と「同じ値」を設定する。
#   生成: openssl rand -base64 48   （32バイト以上）
#   空にすると GET /api/app/graphql-token は 404（連携無効）。
PB_GRAPHQL_JWT_SECRET=
# GraphQL 用 JWT の有効期限（秒）。無効化の反映遅れの上限にもなるので短めに。
PB_GRAPHQL_JWT_TTL_SECONDS=900
# aud クレーム。PostGraphile の jwtVerifyOptions.audience と合わせる。
PB_GRAPHQL_JWT_AUDIENCE=postgraphile
# 一般ユーザーの role クレーム（PostgreSQL のロール名）
PB_GRAPHQL_JWT_DB_ROLE=app_user
# 管理者 (role=admin) の role クレーム（PostgreSQL のロール名）
#   どちらのロールも PostGraphile の接続ロール (authenticator) に GRANT しておくこと。
PB_GRAPHQL_JWT_ADMIN_DB_ROLE=app_admin

# --- SMTP（任意。空なら管理画面の設定を使う） ---------------------------
PB_SMTP_ENABLED=
PB_SMTP_HOST=
PB_SMTP_PORT=
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=
PB_SMTP_SENDER_ADDRESS=
PB_SMTP_SENDER_NAME=

# --- S3（任意。空なら管理画面の設定を使う） -----------------------------
PB_S3_ENABLED=
PB_S3_BUCKET=
PB_S3_REGION=
PB_S3_ENDPOINT=
PB_S3_ACCESS_KEY=
PB_S3_SECRET=
PB_S3_FORCE_PATH_STYLE=

# --- Caddy（docker compose --profile proxy 使用時） ----------------------
PB_DOMAIN=
