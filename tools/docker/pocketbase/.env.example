# =====================================================================
#  App ログインサービス 設定 (.env)   cp .env.example .env
# =====================================================================

# ----- PocketBase 基本 -----
PB_VERSION=0.40.6
PB_PORT=8090
# 公開するホスト側アドレス。Caddy (profile: proxy) を使う本番は 127.0.0.1
PB_BIND=0.0.0.0
PB_APP_NAME=AppLoginService
# 外部から見たURL (メール本文・管理画面リンク等に使用)
PB_APP_URL=http://localhost:8090
# 必須。設定内シークレット(SMTP/S3)の暗号化・コードのハッシュに使用。32文字・初回起動前に決めて以後変更しない
#   生成例: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# ----- 1.1 superuser (管理者) -----
# 管理画面: ${PB_APP_URL}/_/
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please-1234
# true : 起動のたびに上記の値で作成/更新 (パスワードは .env が正)
# false: 初回のみ作成 (以後は管理画面で変更したものを維持)
PB_SUPERUSER_SYNC=true

# ----- 1.2 / 2.1 保存先パス (ホスト側) -----
# DB(SQLite)・バックアップ
PB_DATA_DIR=./data/pb_data
# アップロードファイル実体 (例: /mnt/nas/app_storage)
PB_STORAGE_DIR=./data/storage

# ----- 認証・セッション -----
# ログインに使う項目
#   username,email : 「ユーザーIDまたはEメール」でログイン (既定)
#   username       : ユーザーIDのみ
PB_IDENTITY_FIELDS=username,email
# 認証トークン有効期間(秒)。604800 = 7日 (auth-refresh のたびに延長)
PB_AUTH_TOKEN_DURATION=604800
# パスワード最小文字数 (8 未満は 8)
PB_PASSWORD_MIN_LENGTH=8

# ----- 3. 登録申請・コード (申請 → 管理者承認 → コードでパスワード設定) -----
# 未処理の登録申請の上限 (超えると申請受付を一時停止 = 503)
PB_SIGNUP_MAX_PENDING=100
# 有効化コード (新規登録) の有効期間(時間)
PB_ACTIVATE_CODE_TTL_HOURS=72
# 再設定コード (パスワード忘れ) の有効期間(時間)
PB_RESET_CODE_TTL_HOURS=24
# コード入力の失敗許容回数 (超えるとそのコードは無効)
PB_CODE_MAX_ATTEMPTS=5
# コード通知メール内のアプリ起動リンク (任意, 例: myapp://code)
#   ?username=...&code=... を付けてメールに記載
PB_CODE_LINK_BASE=

# ----- レート制限 (同一IP・1分あたり) -----
# レート制限全体の有効/無効
PB_RATE_LIMIT=true
PB_RATE_LIMIT_SIGNUP_PER_MIN=5
PB_RATE_LIMIT_RESET_REQUEST_PER_MIN=5
PB_RATE_LIMIT_CODE_PER_MIN=10
PB_RATE_LIMIT_LOGIN_PER_MIN=10
# Caddy などのリバースプロキシ経由のとき true (X-Forwarded-For を信頼して IP ごとに制限)
#   true にする場合は PB_BIND=127.0.0.1 で直接アクセスを塞ぐこと
PB_TRUSTED_PROXY=false

# ----- 4. 共有ファイル -----
# 1ファイルの最大サイズ(MB)
PB_FILE_MAX_MB=100

# ----- GraphQL 用 JWT (任意。空なら /api/app/graphql-token は 404) -----
# PostGraphile の jwtSecret と同じ値 (32文字以上を推奨)
PB_GRAPHQL_JWT_SECRET=
PB_GRAPHQL_JWT_TTL_SECONDS=900
PB_GRAPHQL_JWT_AUDIENCE=postgraphile
# JWT の role クレーム (PostgreSQL のロール名)
PB_GRAPHQL_JWT_DB_ROLE=app_user
PB_GRAPHQL_JWT_ADMIN_DB_ROLE=app_admin

# ----- SMTP (コード通知メール。未設定ならコードを手渡し) -----
PB_SMTP_ENABLED=false
PB_SMTP_HOST=
PB_SMTP_PORT=587
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=false
PB_SMTP_SENDER_ADDRESS=noreply@example.com
PB_SMTP_SENDER_NAME=AppLoginService

# ----- S3 互換ストレージ (任意。有効時は PB_STORAGE_DIR の代わりにバケットへ保存) -----
PB_S3_ENABLED=false
PB_S3_BUCKET=
PB_S3_REGION=
PB_S3_ENDPOINT=
PB_S3_ACCESS_KEY=
PB_S3_SECRET=
PB_S3_FORCE_PATH_STYLE=false

# ----- Caddy (profile: proxy) -----
PB_DOMAIN=pb.example.com
# Caddy のリクエストボディ上限 (PB_FILE_MAX_MB より少し大きく)
PB_PROXY_MAX_BODY=110MB
