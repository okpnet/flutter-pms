      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.op_staff(p_staff_id uuid, OUT staff_id uuid, OUT staff_history_id uuid) AS $$\nBEGIN\n    staff_id := COALESCE(p_staff_id, NULLIF(current_setting('jwt.claims.staff_id', true), '')::uuid);\n    SELECT h.history_id INTO staff_history_id FROM tests.history_info_staff AS h\n    WHERE h.info_staff_id = staff_id ORDER BY h.revision DESC, h.update_at DESC LIMIT 1;\n    IF staff_history_id IS NULL THEN\n        RAISE EXCEPTION '担当者が見つかりません (%)', staff_id USING ERRCODE = 'OPR00';\n    END IF;\nEND\n$$ LANGUAGE plpgsql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        1995
      ],
      "schema": "tests"
    },
