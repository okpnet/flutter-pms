.mstr_document_id,\r\n            NEW.code,\r\n            NEW.titles,\r\n            NEW.control_number,\r\n            NEW.mstr_document_tier_id,\r\n            NEW.trans_file_id,\r\n            NEW.version_code,\r\n            NEW.trans_approval_pattern_id,\r\n            NEW.revision,\r\n            NEW.symbol,\r\n            NEW.remarks,\r\n            NEW.update_at,\r\n            NEW.update_user_id,\r\n            NEW.update_user_history_id,\r\n            NEW.remove\r\n        );\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP = 'DELETE') THEN\r\n        RETURN OLD;\r\n    END IF;\r\nEND\r\n$BODY$\r\nLANGUAGE plpgsql VOLATILE;",
