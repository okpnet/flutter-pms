    {
      "id": 3,
      "kind": "function",
      "name": "to_base33",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.to_base33(n bigint, min_len int default 4) RETURNs varchar AS\r\n$BODY$\r\nDECLARE\r\n    alphabet text := '0123456789ABCDEFGHJKMNPQRSTUVWXYZ';\r\n    result text := '';BEGIN\r\n    IF n = 0 THEN\r\n        RETURN lpad('0', min_len, '0');\r\n    END IF;\r\n    WHILE n > 0 LOOP\r\n        result := substr(alphabet, ((n % 33) + 1)::int, 1) || result;\r\n        n := n / 33;\r\n    END LOOP;\r\n    RETURN CASE WHEN length(result) < min_len THEN lpad(result, min_len, '0') ELSE result END;\r\nEND;\r\n$BODY$\r\nLANGUAGE plpgsql immutable;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4,
      "kind": "function",
      "name": "next_seq",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.next_seq(p_table_name varchar, p_yy int, p_mm int) RETURNs bigint AS\r\n$BODY$\r\nDECLARE\r\n    v_counter bigint;\r\nBEGIN\r\n    insert into tests.shared_symbol_counter(table_name, yy, mm, counter)\r\n    values (p_table_name, p_yy, p_mm, 1)\r\n    on conflict (table_name, yy, mm)\r\n    do update set counter = tests.shared_symbol_counter.counter + 1\r\n    RETURNing counter into v_counter;\r\n    RETURN v_counter;\r\nEND;\r\n$BODY$\r\nLANGUAGE plpgsql;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [
        676
      ],
      "schema": ""
    },
    {
      "id": 5,
      "kind": "trigger",
      "name": "trg_gen_symbol_by_month",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_gen_symbol_by_month() RETURNs trigger AS\r\n$BODY$\r\nDECLARE\r\n    v_yy int;\r\n    v_mm int;\r\n    v_seq bigint;\r\nBEGIN\r\n    IF NULLIF(NEW.symbol, '') IS NOT null THEN\r\n        RETURN NEW;\r\n    END IF;\r\n    v_yy := extract(year from now())::int % 100;\r\n    v_mm := extract(month from now())::int;\r\n    v_seq := tests.next_seq(TG_TABLE_NAME::varchar, v_yy, v_mm);\r\n    NEW.symbol := lpad(v_yy::text, 2, '0') || lpad(v_mm::text, 2, '0')\r\n            || '-' || tests.to_base33(v_seq, 4);\r\n    RETURN NEW;\r\nEND;\r\n$BODY$\r\nLANGUAGE plpgsql;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 6,
      "kind": "trigger",
      "name": "trg_gen_symbol_seq",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_gen_symbol_seq() RETURNS TRIGGER AS\r\n$BODY$\r\nDECLARE\r\n    v_seq bigint;\r\nBEGIN\r\n    IF NULLIF(NEW.symbol, '') IS NOT null THEN\r\n        RETURN NEW;\r\n    END IF;\r\n    v_seq := tests.next_seq(TG_TABLE_NAME::varchar, 0, 0);\r\n    NEW.symbol := tests.to_base33(v_seq, 4);\r\n    RETURN NEW;\r\nEND;\r\n$BODY$\r\nLANGUAGE plpgsql;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 7,
      "kind": "trigger",
      "name": "trg_gen_text_summary",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_gen_text_summary() RETURNS TRIGGER AS\r\n$BODY$\r\nDECLARE\r\n    v_lead_len INTEGER := 80;\r\n    v_text     TEXT;\r\nBEGIN\r\n    IF TG_NARGS > 0 THEN\r\n        v_lead_len := TG_ARGV[0]::INTEGER;\r\n    END IF;\r\nv_text := COALESCE(NEW.text_value, '');\r\n    NEW.lead_text  := LEFT(REGEXP_REPLACE(v_text, E'[\\r\\n\\t]+', ' ', 'g'), v_lead_len);\r\n    -- バイト数ではなく文字数\r\n    NEW.char_count := CHAR_LENGTH(v_text);\r\n    RETURN NEW;\r\nEND;\r\n$BODY$\r\nLANGUAGE plpgsql;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "text_valueからlead_text(導入文)とchar_count(文字数)を算出する",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 10,
