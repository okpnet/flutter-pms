        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_02_history_shared_text_value() RETURNS trigger AS\r\n$BODY$\r\nDECLARE\r\n    revisions int;\r\nBEGIN\r\n    IF (TG_OP = 'UPDATE') OR (TG_OP='INSERT') THEN\r\n        SELECT Max(revision) INTO revisions FROM tests.history_shared_text_value WHERE shared_text_value_id=NEW.shared_text_value_id;\r\n        IF (revisions >= 0) THEN\r\n            IF (\r\n                NEW.shared_text_value_id,\r\n                NEW.shared_language_code_id,\r\n                NEW.shared_text_id,\r\n                NEW.char_count,\r\n                NEW.lead_text,\r\n                NEW.text_value,\r\n                NEW.symbol,\r\n                NEW.remarks,\r\n                NEW.remove\r\n            ) IS NOT DISTINCT FROM (\r\n                OLD.shared_text_value_id,\r\n                OLD.shared_language_code_id,\r\n                OLD.shared_text_id,\r\n                OLD.char_count,\r\n                OLD.lead_text,\r\n                OLD.text_value,\r\n                OLD.symbol,\r\n                OLD.remarks,\r\n                OLD.remove\r\n            )\r\n            THEN\r\n                RETURN NULL;\r\n            END IF;\r\n            NEW.revision := revisions + 1;\r\n        ELSE\r\n            NEW.revision := 1;\r\n        END IF;\r\n        INSERT INTO tests.history_shared_text_value (\r\n            shared_text_value_id,\r\n            shared_language_code_id,\r\n            shared_text_id,\r\n            char_count,\r\n            lead_text,\r\n            text_value,\r\n            revision,\r\n            symbol,\r\n            remarks,\r\n            update_at,\r\n            update_user_id,\r\n            update_user_history_id,\r\n            remove\r\n        )\r\n        VALUES\r\n        (\r\n            NEW.shared_text_value_id,\r\n            NEW.shared_language_code_id,\r\n            NEW.shared_text_id,\r\n            NEW.char_count,\r\n            NEW.lead_text,\r\n            NEW.text_value,\r\n            NEW.revision,\r\n            NEW.symbol,\r\n            NEW.remarks,\r\n            NEW.update_at,\r\n            NEW.update_user_id,\r\n            NEW.update_user_history_id,\r\n            NEW.remove\r\n        );\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP = 'DELETE') THEN\r\n        RETURN OLD;\r\n    END IF;\r\nEND\r\n$BODY$\r\nLANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
