    {
      "id": 4190,
      "kind": "function",
      "name": "mrp_discard",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_discard(p_run_id uuid, p_staff_id uuid DEFAULT NULL) RETURNS tests.trans_mrp_run AS $$\r\n    UPDATE tests.trans_mrp_run\r\n    SET status = 2, update_user_id = tests.mrp_staff(p_staff_id),\r\n        update_user_history_id = tests.mrp_hist_staff(tests.mrp_staff(p_staff_id))\r\n    WHERE trans_mrp_run_id = p_run_id AND status = 0\r\n    RETURNING *;\r\n$$ LANGUAGE sql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "MRP実行の破棄",
      "args": "uuid, uuid",
      "dependsOnTableIds": [
        4036
      ],
      "schema": ""
    },
    {
      "id": 4191,
      "kind": "function",
      "name": "mrp_execute",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_execute(\r\n    p_mode smallint,\r\n    p_staff_id uuid DEFAULT NULL,\r\n    p_order_detail_ids uuid[] DEFAULT NULL,\r\n    p_accept_late boolean DEFAULT false\r\n) RETURNS tests.trans_mrp_run AS $$\r\nDECLARE\r\n    v_run tests.trans_mrp_run;\r\nBEGIN\r\n    v_run := tests.mrp_run(p_mode, p_staff_id, p_order_detail_ids, p_accept_late);\r\n    IF v_run.pending_count = 0 THEN\r\n        v_run := tests.mrp_commit(v_run.trans_mrp_run_id, p_staff_id, false);\r\n    END IF;\r\n    RETURN v_run;\r\nEND\r\n$$ LANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "MRPボタン用。計算し、要判断が無ければそのまま確定する。status=0 で返ったら提案の確認画面へ。",
      "args": "smallint, uuid, uuid[], boolean",
      "dependsOnTableIds": [
        4036
      ],
      "schema": ""
    },
    {
      "id": 4192,
      "kind": "function",
      "name": "mrp_set_decision",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_set_decision(\r\n    p_run_id uuid,\r\n    p_decision smallint,\r\n    p_suggestion_ids uuid[] DEFAULT NULL,\r\n    p_staff_id uuid DEFAULT NULL\r\n) RETURNS SETOF tests.trans_mrp_suggestion AS $$\r\nDECLARE\r\n    v_staff uuid := tests.mrp_staff(p_staff_id);\r\nBEGIN\r\n    IF p_decision NOT IN (0, 1, 2) THEN\r\n        RAISE EXCEPTION 'mrp_set_decision: 判断は 0/1/2 です' USING ERRCODE = 'MRP00';\r\n    END IF;\r\n    RETURN QUERY\r\n    UPDATE tests.trans_mrp_suggestion AS s\r\n    SET decision = p_decision, update_user_id = v_staff, update_user_history_id = tests.mrp_hist_staff(v_staff)\r\n    WHERE s.trans_mrp_run_id = p_run_id AND s.decision <> 9\r\n      AND (p_suggestion_ids IS NULL OR s.trans_mrp_suggestion_id = ANY (p_suggestion_ids))\r\n    RETURNING s.*;\r\nEND\r\n$$ LANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "MRP提案の採否をまとめて変更",
      "args": "uuid, smallint, uuid[], uuid",
      "dependsOnTableIds": [
        4055
      ],
      "schema": ""
    },
    {
      "id": 4193,
      "kind": "trigger",
      "name": "trg_05_mrp_suggestion_guard",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_05_mrp_suggestion_guard() RETURNS trigger AS $$\r\nBEGIN\r\n    IF (SELECT r.status FROM tests.trans_mrp_run AS r WHERE r.trans_mrp_run_id = OLD.trans_mrp_run_id) <> 0 THEN\r\n        RAISE EXCEPTION 'このMRP実行は確定・破棄・失効しているため、提案を変更できません' USING ERRCODE = 'MRP03';\r\n    END IF;\r\n    IF OLD.decision = 9 AND NEW.decision IS DISTINCT FROM 9 THEN\r\n        RAISE EXCEPTION '情報の提案は採否を変更できません' USING ERRCODE = 'MRP00';\r\n    END IF;\r\n    RETURN NEW;\r\nEND\r\n$$ LANGUAGE plpgsql;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4194,
      "kind": "trigger",
      "name": "trg_05_mrp_suggestion_task_guard",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_05_mrp_suggestion_task_guard() RETURNS trigger AS $$\r\nBEGIN\r\n    IF (SELECT r.status FROM tests.trans_mrp_suggestion AS s\r\n        INNER JOIN tests.trans_mrp_run AS r ON r.trans_mrp_run_id = s.trans_mrp_run_id\r\n        WHERE s.trans_mrp_suggestion_id = OLD.trans_mrp_suggestion_id) <> 0\r\n       AND NEW.trans_work_plan_id IS NOT DISTINCT FROM OLD.trans_work_plan_id THEN\r\n        RAISE EXCEPTION 'このMRP実行は確定・破棄・失効しているため、工程を変更できません' USING ERRCODE = 'MRP03';\r\n    END IF;\r\n    RETURN NEW;\r\nEND\r\n$$ LANGUAGE plpgsql;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4195,
      "kind": "function",
      "name": "mrp_purge",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_purge(p_keep_days integer DEFAULT 30) RETURNS integer AS $$\r\nDECLARE\r\n    v_n integer;\r\nBEGIN\r\n    DROP TABLE IF EXISTS _mrp_purge;\r\n    CREATE TEMP TABLE _mrp_purge ON COMMIT DROP AS\r\n    SELECT trans_mrp_run_id FROM tests.trans_mrp_run\r\n    WHERE status IN (2, 3) AND run_at < now() - make_interval(days => p_keep_days);\r\n    DELETE FROM tests.trans_mrp_pegging WHERE trans_mrp_run_id IN (SELECT trans_mrp_run_id FROM _mrp_purge);\r\n    DELETE FROM tests.trans_mrp_load WHERE trans_mrp_run_id IN (SELECT trans_mrp_run_id FROM _mrp_purge);\r\n    -- 提案と提案工程は相互に参照する (FKは DEFERRABLE なので同じトランザクションでまとめて消せる)\r\n    DELETE FROM tests.trans_mrp_suggestion_task WHERE trans_mrp_suggestion_id IN (\r\n        SELECT trans_mrp_suggestion_id FROM tests.trans_mrp_suggestion\r\n        WHERE trans_mrp_run_id IN (SELECT trans_mrp_run_id FROM _mrp_purge));\r\n    DELETE FROM tests.trans_mrp_suggestion WHERE trans_mrp_run_id IN (SELECT trans_mrp_run_id FROM _mrp_purge);\r\n    DELETE FROM tests.trans_mrp_run WHERE trans_mrp_run_id IN (SELECT trans_mrp_run_id FROM _mrp_purge);\r\n    GET DIAGNOSTICS v_n = ROW_COUNT;\r\n    DROP TABLE _mrp_purge;\r\n    RETURN v_n;\r\nEND\r\n$$ LANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "破棄・失効したMRP実行の削除",
      "args": "integer",
      "dependsOnTableIds": [
