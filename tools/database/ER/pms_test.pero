    {
      "id": 4163,
      "kind": "function",
      "name": "mrp_capacity",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_capacity(p_equipment uuid, p_date date) RETURNS numeric AS $$\r\n    SELECT COALESCE(\r\n        (SELECT CASE WHEN c.holiday THEN 0 ELSE EXTRACT(EPOCH FROM COALESCE(c.work_interval, INTERVAL '0')) / 3600 END\r\n           FROM tests.mstr_work_calendar AS c\r\n          WHERE p_equipment IS NOT NULL AND c.mstr_equipment_id = p_equipment AND c.work_date = p_date AND c.remove IS FALSE LIMIT 1),\r\n        (SELECT CASE WHEN c.holiday THEN 0 ELSE EXTRACT(EPOCH FROM COALESCE(c.work_interval, INTERVAL '0')) / 3600 END\r\n           FROM tests.mstr_work_calendar AS c\r\n          WHERE c.mstr_equipment_id IS NULL AND c.work_date = p_date AND c.remove IS FALSE LIMIT 1),\r\n        CASE WHEN EXTRACT(ISODOW FROM p_date) <= 5 THEN 8 ELSE 0 END\r\n    )::numeric;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
