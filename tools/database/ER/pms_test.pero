    {
      "id": 3892,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_purchase_purchase_detail_count",
      "comment": "@foreignKey (trans_purchase_id) references trans_purchase (trans_purchase_id)\n@unique trans_purchase_id",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
