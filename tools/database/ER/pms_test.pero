    {
      "id": 3784,
      "kind": "trigger",
      "name": "trg_02_history_mstr_inspection",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_02_history_mstr_inspection() RETURNS trigger AS\r\n$BODY$\r\nDECLARE\r\n    revisions int;\r\nBEGIN\r\n    IF (TG_OP = 'UPDATE') OR (TG_OP='INSERT') THEN\r\n        SELECT Max(revision) INTO revisions FROM tests.history_mstr_inspection WHERE mstr_inspection_id=NEW.mstr_inspection_id;\r\n        IF (revisions >= 0) THEN\r\n            IF (\r\n                NEW.mstr_inspection_id,\r\n                NEW.code,\r\n                NEW.names,\r\n                NEW.inspection_kind,\r\n                NEW.base_date,\r\n                NEW.time_interval,\r\n                NEW.external_inspection,\r\n                NEW.inspection_formula_id,\r\n                NEW.mstr_item_id,\r\n                NEW.symbol,\r\n                NEW.remarks,\r\n                NEW.remove\r\n            ) IS NOT DISTINCT FROM (\r\n                OLD.mstr_inspection_id,\r\n                OLD.code,\r\n                OLD.names,\r\n                OLD.inspection_kind,\r\n                OLD.base_date,\r\n                OLD.time_interval,\r\n                OLD.external_inspection,\r\n                OLD.inspection_formula_id,\r\n                OLD.mstr_item_id,\r\n                OLD.symbol,\r\n                OLD.remarks,\r\n                OLD.remove\r\n            )\r\n            THEN\r\n                RETURN NULL;\r\n            END IF;\r\n            NEW.revision := revisions + 1;\r\n        ELSE\r\n            NEW.revision := 1;\r\n        END IF;\r\n        INSERT INTO tests.history_mstr_inspection (\r\n            mstr_inspection_id,\r\n            code,\r\n            names,\r\n            inspection_kind,\r\n            base_date,\r\n            time_interval,\r\n            external_inspection,\r\n            inspection_formula_id,\r\n            mstr_item_id,\r\n            revision,\r\n            symbol,\r\n            remarks,\r\n            update_at,\r\n            update_user_id,\r\n            update_user_history_id,\r\n            remove\r\n        )\r\n        VALUES\r\n        (\r\n            NEW.mstr_inspection_id,\r\n            NEW.code,\r\n            NEW.names,\r\n            NEW.inspection_kind,\r\n            NEW.base_date,\r\n            NEW.time_interval,\r\n            NEW.external_inspection,\r\n            NEW.inspection_formula_id,\r\n            NEW.mstr_item_id,\r\n            NEW.revision,\r\n            NEW.symbol,\r\n            NEW.remarks,\r\n            NEW.update_at,\r\n            NEW.update_user_id,\r\n            NEW.update_user_history_id,\r\n            NEW.remove\r\n        );\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP = 'DELETE') THEN\r\n        RETURN OLD;\r\n    END IF;\r\nEND\r\n$BODY$\r\nLANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
