    {
      "id": 3539,
      "kind": "trigger",
      "name": "trg_02_history_mstr_item_supplier",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_02_history_mstr_item_supplier() RETURNS trigger AS\r\n$BODY$\r\nDECLARE\r\n    revisions int;\r\nBEGIN\r\n    IF (TG_OP = 'UPDATE') OR (TG_OP='INSERT') THEN\r\n        SELECT Max(revision) INTO revisions FROM tests.history_mstr_item_supplier WHERE mstr_item_supplier_id=NEW.mstr_item_supplier_id;\r\n        IF (revisions >= 0) THEN\r\n            IF (\r\n                NEW.mstr_item_supplier_id,\r\n                NEW.priority,\r\n                NEW.quality_inspection_time,\r\n                NEW.mstr_stakeholder_id,\r\n                NEW.mstr_item_id,\r\n                NEW.supplier_item_code,\r\n                NEW.delivery_time,\r\n                NEW.minimum_lot_size,\r\n                NEW.cost,\r\n                NEW.asking_price,\r\n                NEW.symbol,\r\n                NEW.remarks,\r\n                NEW.remove\r\n            ) IS NOT DISTINCT FROM (\r\n                OLD.mstr_item_supplier_id,\r\n                OLD.priority,\r\n                OLD.quality_inspection_time,\r\n                OLD.mstr_stakeholder_id,\r\n                OLD.mstr_item_id,\r\n                OLD.supplier_item_code,\r\n                OLD.delivery_time,\r\n                OLD.minimum_lot_size,\r\n                OLD.cost,\r\n                OLD.asking_price,\r\n                OLD.symbol,\r\n                OLD.remarks,\r\n                OLD.remove\r\n            )\r\n            THEN\r\n                RETURN NULL;\r\n            END IF;\r\n            NEW.revision := revisions + 1;\r\n        ELSE\r\n            NEW.revision := 1;\r\n        END IF;\r\n        INSERT INTO tests.history_mstr_item_supplier (\r\n            mstr_item_supplier_id,\r\n            priority,\r\n            quality_inspection_time,\r\n            mstr_stakeholder_id,\r\n            mstr_item_id,\r\n            supplier_item_code,\r\n            delivery_time,\r\n            minimum_lot_size,\r\n            cost,\r\n            asking_price,\r\n            revision,\r\n            symbol,\r\n            remarks,\r\n            update_at,\r\n            update_user_id,\r\n            update_user_history_id,\r\n            remove\r\n        )\r\n        VALUES\r\n        (\r\n            NEW.mstr_item_supplier_id,\r\n            NEW.priority,\r\n            NEW.quality_inspection_time,\r\n            NEW.mstr_stakeholder_id,\r\n            NEW.mstr_item_id,\r\n            NEW.supplier_item_code,\r\n            NEW.delivery_time,\r\n            NEW.minimum_lot_size,\r\n            NEW.cost,\r\n            NEW.asking_price,\r\n            NEW.revision,\r\n            NEW.symbol,\r\n            NEW.remarks,\r\n            NEW.update_at,\r\n            NEW.update_user_id,\r\n            NEW.update_user_history_id,\r\n            NEW.remove\r\n        );\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP = 'DELETE') THEN\r\n        RETURN OLD;\r\n    END IF;\r\nEND\r\n$BODY$\r\nLANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
