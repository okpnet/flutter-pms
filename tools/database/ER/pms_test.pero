    },
    {
      "id": 4188,
      "kind": "function",
      "name": "mrp_cancel_purchase_detail",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_cancel_purchase_detail(p_pd uuid, p_suggestion uuid, p_run uuid,\r\n                                                            p_staff uuid, p_staff_hist uuid, p_reason varchar)\r\nRETURNS void AS $$\r\nDECLARE v_old numeric; v_rem numeric; v_qty numeric;\r\nBEGIN\r\n    SELECT pd.cancel_quantity, b.remaining_quantity, b.quantity INTO v_old, v_rem, v_qty\r\n    FROM tests.trans_purchase_detail AS pd\r\n    INNER JOIN tests.v_purchase_detail_balance AS b ON b.trans_purchase_detail_id = pd.trans_purchase_detail_id\r\n    WHERE pd.trans_purchase_detail_id = p_pd;\r\n    IF NOT FOUND OR COALESCE(v_rem, 0) <= 0 THEN RETURN; END IF;\r\n    UPDATE tests.trans_purchase_detail\r\n    SET cancel_quantity = LEAST(COALESCE(cancel_quantity, 0) + v_rem, v_qty),\r\n        update_user_id = p_staff, update_user_history_id = p_staff_hist\r\n    WHERE trans_purchase_detail_id = p_pd;\r\n    INSERT INTO tests.trans_plan_change (trans_purchase_detail_id, cancel_quantity, old_quantity, new_quantity, reason,\r\n                                         staff_history_id, staff_id, trans_mrp_suggestion_id, reflected_trans_mrp_run_id,\r\n                                         update_user_id, update_user_history_id)\r\n    VALUES (p_pd, v_rem, v_qty, v_qty, p_reason, p_staff_hist, p_staff, p_suggestion, p_run, p_staff, p_staff_hist);\r\nEND\r\n$$ LANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, uuid, uuid, uuid, uuid, varchar",
      "dependsOnTableIds": [
        151,
        3055,
