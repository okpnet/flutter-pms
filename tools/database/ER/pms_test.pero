    {
      "id": 3514,
      "kind": "trigger",
      "name": "trg_01_updatetimes_trans_visiter_owner",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_01_updatetimes_trans_visiter_owner() RETURNS trigger AS\r\n$BODY$\r\nDECLARE\r\n    latest_row record;\r\nBEGIN\r\n    IF (TG_OP = 'UPDATE') THEN\r\n        NEW.update_at:=now();\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP='INSERT') THEN\r\n        NEW.trans_visiter_owner_id := gen_random_uuid();\r\n        NEW.update_at:=now();\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP = 'DELETE') THEN\r\n        RETURN OLD;\r\n    END IF;\r\nEND\r\n$BODY$\r\nLANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
