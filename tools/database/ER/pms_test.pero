    {
      "id": 3906,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_external_property",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (owner_stakeholder_id) references mstr_stakeholder (mstr_stakeholder_id)\n@foreignKey (item_id) references mstr_item (mstr_item_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n@foreignKey (trans_supply_detail_id) references trans_supply_detail (trans_supply_detail_id)\n@foreignKey (trans_order_detail_id) references trans_order_detail (trans_order_detail_id)\n社外の所有物(顧客・発注先)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 社外の所有物 (顧客・発注先。ISO 9001 8.5.3 の所有物一覧)  claude/131\r\n-- 今の数量が残っている在庫(ロット)のうち、有効な所有者(trans_visiter_owner)が自社ではないもの\r\nSELECT\r\n    o.trans_visiter_id\r\n    , l.symbol\r\n    , o.owner_stakeholder_id\r\n    , o.owner_stakeholder_history_id\r\n    , vi.item_id\r\n    , l.trans_container_id\r\n    , l.mstr_location_id\r\n    , l.quantity\r\n    , l.release\r\n    , l.open_complaint_count\r\n    , o.trans_supply_detail_id\r\n    , o.trans_order_detail_id\r\n    , o.effective_at\r\nFROM tests.trans_visiter_owner AS o\r\nINNER JOIN tests.v_visiter_lot AS l ON l.trans_visiter_id = o.trans_visiter_id\r\nLEFT JOIN tests.v_mrp_visiter_item AS vi ON vi.trans_visiter_id = o.trans_visiter_id\r\nWHERE o.remove IS FALSE AND o.owner_stakeholder_id IS NOT NULL AND l.quantity > 0",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
