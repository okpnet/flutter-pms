    {
      "id": 3893,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_item",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n在庫(ロット)の品目",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 在庫(ロット)の品目 (issue 20261107_0009 B案)\r\n-- 分割・移動した在庫は、分割元をたどった最初の在庫(root_visiter_id)の\r\n-- 受入実績(発注明細の品目)・作業実績(生産計画 → 資材計画の品目)・支給・返品(明細の品目)で決める。\r\nSELECT\r\n    l.trans_visiter_id\r\n    , l.symbol\r\n    , COALESCE(pd.item_id, rp.item_id, sp.item_id, rt.item_id) AS mstr_item_id\r\nFROM tests.v_visiter_lot AS l\r\nLEFT JOIN LATERAL (\r\n    -- 受入実績(購入品)の品目\r\n    SELECT d.item_id\r\n    FROM tests.trans_purchase_rec_visiter AS prv\r\n    INNER JOIN tests.trans_purchase_rec AS pr\r\n        ON pr.trans_purchase_rec_id = prv.trans_purchase_rec_id AND pr.remove IS FALSE\r\n    INNER JOIN tests.trans_purchase_detail AS d\r\n        ON d.trans_purchase_detail_id = pr.trans_purchase_detail_id\r\n    WHERE prv.trans_visiter_id = COALESCE(l.root_visiter_id, l.trans_visiter_id)\r\n    LIMIT 1\r\n) AS pd ON TRUE\r\nLEFT JOIN LATERAL (\r\n    -- 作業実績(製造品)の品目\r\n    SELECT r.item_id\r\n    FROM tests.trans_work_record_visiter AS wrv\r\n    INNER JOIN tests.trans_work_record AS wr\r\n        ON wr.trans_work_record_id = wrv.trans_work_record_id AND wr.remove IS FALSE\r\n    INNER JOIN tests.trans_work_plan AS wp\r\n        ON wp.trans_work_plan_id = wr.trans_work_plan_id\r\n    INNER JOIN tests.trans_operations_plan AS op\r\n        ON op.trans_operations_plan_id = wp.trans_operations_plan_id\r\n    INNER JOIN tests.trans_resource_plan AS r\r\n        ON r.trans_resource_plan_id = op.trans_resource_plan_id\r\n    WHERE wrv.trans_visiter_id = COALESCE(l.root_visiter_id, l.trans_visiter_id)\r\n    LIMIT 1\r\n) AS rp ON TRUE\r\nLEFT JOIN LATERAL (\r\n    -- 支給で入庫した在庫(顧客支給材・発注先からの戻り)の品目  claude/131\r\n    SELECT d.item_id\r\n    FROM tests.trans_supply_visiter AS sv\r\n    INNER JOIN tests.trans_supply_detail AS d\r\n        ON d.trans_supply_detail_id = sv.trans_supply_detail_id AND d.remove IS FALSE\r\n    WHERE sv.trans_visiter_id = COALESCE(l.root_visiter_id, l.trans_visiter_id) AND sv.remove IS FALSE\r\n    LIMIT 1\r\n) AS sp ON TRUE\r\nLEFT JOIN LATERAL (\r\n    -- 返品で入庫した在庫(顧客からの返品)の品目  claude/131\r\n    SELECT d.item_id\r\n    FROM tests.trans_return_visiter AS rv\r\n    INNER JOIN tests.trans_return_detail AS d\r\n        ON d.trans_return_detail_id = rv.trans_return_detail_id AND d.remove IS FALSE\r\n    WHERE rv.trans_visiter_id = COALESCE(l.root_visiter_id, l.trans_visiter_id) AND rv.remove IS FALSE\r\n    LIMIT 1\r\n) AS rt ON TRUE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3894,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_inspect_record_inspection_report_count",
      "comment": "@foreignKey (trans_inspect_record_id) references trans_inspect_record (trans_inspect_record_id)\n@unique trans_inspect_record_id",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    p.trans_inspect_record_id\r\n    , COUNT(c.trans_inspect_record_id) AS all_count\r\n    , COUNT(c.trans_inspect_record_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\r\n    , COUNT(c.trans_inspect_record_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\r\nFROM\r\n    tests.trans_inspect_record AS p\r\n    LEFT JOIN tests.trans_inspection_report AS c\r\n        ON c.trans_inspect_record_id = p.trans_inspect_record_id\r\nGROUP BY\r\n    p.trans_inspect_record_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3895,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_stock_status",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (mstr_location_id) references mstr_location (mstr_location_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n在庫状況(出庫可能数つき)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 在庫状況 (画面の stockstatus。1行 = 在庫(ロット) 1件)\r\n-- quantity   : 今の数量(v_visiter_lot.quantity)\r\n-- safety     : 品目の安全在庫(mstr_item_lot.safety_inventory。品目全体の値で、行ごとに重複して引かない)\r\n-- reserved   : この在庫を引当元にした引当予約の合計(trans_inventory_request.quantity)\r\n-- available  : 出庫可能数 = 0 以上の min(この在庫の空き, 品目全体の在庫 − 品目全体の引当済 − 安全在庫)\r\nWITH lot AS (\r\n    SELECT\r\n        l.trans_visiter_id\r\n        , l.symbol\r\n        , l.mstr_location_id\r\n        , l.trans_container_id\r\n        , vi.mstr_item_id\r\n        , l.quantity\r\n        , COALESCE(rz.reserved, 0) AS reserved\r\n        , COALESCE(il.safety_inventory, 0) AS safety\r\n    FROM tests.v_visiter_lot AS l\r\n    LEFT JOIN tests.v_visiter_item AS vi\r\n        ON vi.trans_visiter_id = l.trans_visiter_id\r\n    LEFT JOIN tests.mstr_item AS i\r\n        ON i.mstr_item_id = vi.mstr_item_id\r\n    LEFT JOIN tests.mstr_item_lot AS il\r\n        ON il.mstr_item_lot_id = i.mstr_item_lot_id\r\n    LEFT JOIN LATERAL (\r\n        SELECT SUM(ir.quantity) AS reserved\r\n        FROM tests.trans_inventory_request AS ir\r\n        WHERE ir.trans_visiter_id = l.trans_visiter_id AND ir.remove IS FALSE\r\n    ) AS rz ON TRUE\r\n    WHERE l.quantity > 0\r\n)\r\nSELECT\r\n    lot.trans_visiter_id\r\n    , lot.symbol\r\n    , lot.mstr_location_id\r\n    , lot.trans_container_id\r\n    , lot.mstr_item_id\r\n    , lot.quantity\r\n    , lot.safety\r\n    , lot.reserved\r\n    , GREATEST(\r\n          LEAST(\r\n              lot.quantity - lot.reserved\r\n              , SUM(lot.quantity) OVER (PARTITION BY lot.mstr_item_id)\r\n                - SUM(lot.reserved) OVER (PARTITION BY lot.mstr_item_id)\r\n                - lot.safety\r\n          )\r\n          , 0\r\n      ) AS available\r\nFROM lot",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3896,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_stakeholder_outsource_available_count",
      "comment": "@foreignKey (mstr_stakeholder_id) references mstr_stakeholder (mstr_stakeholder_id)\n@unique mstr_stakeholder_id",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    p.mstr_stakeholder_id\r\n    , COUNT(c.mstr_stakeholder_id) AS all_count\r\n    , COUNT(c.mstr_stakeholder_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\r\n    , COUNT(c.mstr_stakeholder_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\r\nFROM\r\n    tests.mstr_stakeholder AS p\r\n    LEFT JOIN tests.mstr_outsource_available AS c\r\n        ON c.mstr_stakeholder_id = p.mstr_stakeholder_id\r\nGROUP BY\r\n    p.mstr_stakeholder_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3897,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_purchase_detail_unreserved",
      "comment": "@primaryKey trans_purchase_detail_id\n@foreignKey (trans_purchase_detail_id) references trans_purchase_detail (trans_purchase_detail_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n発注明細の未引当数量",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 発注明細の未引当数量\r\n-- quantity   : 発注数量\r\n-- reserved   : 購買引当(trans_purchase_rez)を通した引当予約の合計(trans_inventory_request.quantity)\r\n-- unreserved : 未引当数量 = 発注数量 − 引当済(0 未満にはならない)\r\nSELECT\r\n    d.trans_purchase_detail_id\r\n    , d.symbol\r\n    , d.item_id AS mstr_item_id\r\n    , d.quantity\r\n    , COALESCE(rz.reserved, 0) AS reserved\r\n    , GREATEST(d.quantity - COALESCE(rz.reserved, 0), 0) AS unreserved\r\nFROM tests.trans_purchase_detail AS d\r\nLEFT JOIN LATERAL (\r\n    SELECT SUM(ir.quantity) AS reserved\r\n    FROM tests.trans_purchase_rez AS pz\r\n    INNER JOIN tests.trans_inventory_request AS ir\r\n        ON ir.trans_purchase_rez_id = pz.trans_purchase_rez_id AND ir.remove IS FALSE\r\n    WHERE pz.trans_purchase_detail_id = d.trans_purchase_detail_id AND pz.remove IS FALSE\r\n) AS rz ON TRUE\r\nWHERE d.remove IS FALSE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3898,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_equipment_equipment_available_count",
      "comment": "@foreignKey (mstr_equipment_id) references mstr_equipment (mstr_equipment_id)\n@unique mstr_equipment_id",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
