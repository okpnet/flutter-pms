      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_02_history_info_staff_icon() RETURNS trigger AS\r\n$BODY$\r\nDECLARE\r\n    revisions int;\r\nBEGIN\r\n    IF (TG_OP = 'UPDATE') OR (TG_OP='INSERT') THEN\r\n        SELECT Max(revision) INTO revisions FROM tests.history_info_staff_icon WHERE info_staff_icon_id=NEW.info_staff_icon_id;\r\n        IF (revisions >= 0) THEN\r\n            IF (\r\n                NEW.info_staff_icon_id,\r\n                NEW.trans_file_id,\r\n                NEW.staff_history_id,\r\n                NEW.staff_id,\r\n                NEW.names,\r\n                NEW.symbol,\r\n                NEW.remarks,\r\n                NEW.remove\r\n            ) IS NOT DISTINCT FROM (\r\n                OLD.info_staff_icon_id,\r\n                OLD.trans_file_id,\r\n                OLD.staff_history_id,\r\n                OLD.staff_id,\r\n                OLD.names,\r\n                OLD.symbol,\r\n                OLD.remarks,\r\n                OLD.remove\r\n            )\r\n            THEN\r\n                RETURN NULL;\r\n            END IF;\r\n            NEW.revision := revisions + 1;\r\n        ELSE\r\n            NEW.revision := 1;\r\n        END IF;\r\n        INSERT INTO tests.history_info_staff_icon (\r\n            info_staff_icon_id,\r\n            trans_file_id,\r\n            staff_history_id,\r\n            staff_id,\r\n            names,\r\n            revision,\r\n            symbol,\r\n            remarks,\r\n            update_at,\r\n            update_user_id,\r\n            update_user_history_id,\r\n            remove\r\n        )\r\n        VALUES\r\n        (\r\n            NEW.info_staff_icon_id,\r\n            NEW.trans_file_id,\r\n            NEW.staff_history_id,\r\n            NEW.staff_id,\r\n            NEW.names,\r\n            NEW.revision,\r\n            NEW.symbol,\r\n            NEW.remarks,\r\n            NEW.update_at,\r\n            NEW.update_user_id,\r\n            NEW.update_user_history_id,\r\n            NEW.remove\r\n        );\r\n        RETURN NEW;\r\n    ELSEIF (TG_OP = 'DELETE') THEN\r\n        RETURN OLD;\r\n    END IF;\r\nEND\r\n$BODY$\r\nLANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "",
      "args": "",
      "dependsOnTableIds": [],
      "schema": ""
    },
