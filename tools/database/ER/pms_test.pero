    {
      "id": 3865,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_plan_change_unreflected",
      "comment": "@primaryKey trans_plan_change_id\n@unique symbol\n@foreignKey (trans_plan_change_id) references trans_plan_change (trans_plan_change_id)\n@foreignKey (trans_order_detail_id) references trans_order_detail (trans_order_detail_id)\n@foreignKey (trans_purchase_detail_id) references trans_purchase_detail (trans_purchase_detail_id)\n@foreignKey (trans_operations_plan_id) references trans_operations_plan (trans_operations_plan_id)\nMRP未反映の計画変更",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- MRP 未反映の計画変更  claude/131\r\n-- 受注明細・発注明細・生産計画の変更で、MRP の提案から作られたものでなく(trans_mrp_suggestion_id が NULL)、\r\n-- まだ反映した MRP 実行が無いもの(reflected_trans_mrp_run_id が NULL)。\r\n-- 生産計画の変更は、その生産計画の受注明細にも数える (受注明細一覧のバッジ用)\r\nSELECT\r\n    pc.trans_plan_change_id\r\n    , pc.symbol\r\n    , pc.change_at\r\n    , COALESCE(pc.trans_order_detail_id, op_od.trans_order_detail_id) AS trans_order_detail_id\r\n    , pc.trans_purchase_detail_id\r\n    , pc.trans_operations_plan_id\r\n    , pc.staff_id\r\nFROM tests.trans_plan_change AS pc\r\nLEFT JOIN LATERAL (\r\n    SELECT rp.trans_order_detail_id FROM tests.trans_operations_plan AS op\r\n    INNER JOIN tests.trans_resource_plan AS rp ON rp.trans_resource_plan_id = op.trans_resource_plan_id\r\n    WHERE op.trans_operations_plan_id = pc.trans_operations_plan_id\r\n) AS op_od ON TRUE\r\nWHERE pc.remove IS FALSE\r\n  AND pc.reflected_trans_mrp_run_id IS NULL\r\n  AND pc.trans_mrp_suggestion_id IS NULL\r\n  AND (pc.trans_order_detail_id IS NOT NULL OR pc.trans_purchase_detail_id IS NOT NULL OR pc.trans_operations_plan_id IS NOT NULL)",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3866,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_purchase_detail_balance",
      "comment": "@primaryKey trans_purchase_detail_id\n@unique symbol\n@foreignKey (trans_purchase_detail_id) references trans_purchase_detail (trans_purchase_detail_id)\n@foreignKey (trans_purchase_id) references trans_purchase (trans_purchase_id)\n@foreignKey (item_id) references mstr_item (mstr_item_id)\n発注明細の残",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 発注明細の残 (MRP の供給の数え方)  claude/131\r\n-- remaining_quantity : 数量 − キャンセル数量 − 受入済み ＋ 代品ありの返品(仕入先・外注先への返品)\r\n-- open_quantity      : 停止中は 0\r\n-- is_outsource       : 外注加工 (生産計画明細から参照される発注明細)。品目の供給ではない\r\n-- 返品は入出庫判定区分マスタの receive = false (仕入先・外注先への返品) だけを数える\r\nSELECT\r\n    pd.trans_purchase_detail_id\r\n    , pd.symbol\r\n    , pd.trans_purchase_id\r\n    , pd.item_id\r\n    , pd.stop\r\n    , pd.material_supply\r\n    , pd.paid_supply\r\n    , EXISTS (SELECT 1 FROM tests.trans_work_plan AS wp\r\n              WHERE wp.trans_purchase_detail_id = pd.trans_purchase_detail_id AND wp.remove IS FALSE) AS is_outsource\r\n    , COALESCE(pd.quantity, 0) AS quantity\r\n    , pd.cancel_quantity\r\n    , COALESCE(rc.q, 0) AS received_quantity\r\n    , COALESCE(rt.q, 0) AS returned_quantity\r\n    , COALESCE(rt.q_rep, 0) AS replacement_quantity\r\n    , GREATEST(COALESCE(pd.quantity, 0) - pd.cancel_quantity - COALESCE(rc.q, 0) + COALESCE(rt.q_rep, 0), 0) AS remaining_quantity\r\n    , CASE WHEN pd.stop THEN 0\r\n           ELSE GREATEST(COALESCE(pd.quantity, 0) - pd.cancel_quantity - COALESCE(rc.q, 0) + COALESCE(rt.q_rep, 0), 0) END AS open_quantity\r\n    , (pd.cancel_quantity > 0\r\n       AND COALESCE(pd.quantity, 0) - pd.cancel_quantity - COALESCE(rc.q, 0) + COALESCE(rt.q_rep, 0) <= 0) AS cancel_closed\r\nFROM tests.trans_purchase_detail AS pd\r\nLEFT JOIN LATERAL (\r\n    SELECT SUM(r.quantity) AS q FROM tests.trans_purchase_rec AS r\r\n    WHERE r.trans_purchase_detail_id = pd.trans_purchase_detail_id AND r.remove IS FALSE\r\n) AS rc ON TRUE\r\nLEFT JOIN LATERAL (\r\n    SELECT SUM(d.quantity) AS q, SUM(d.quantity) FILTER (WHERE d.replacement) AS q_rep\r\n    FROM tests.trans_return_detail AS d\r\n    INNER JOIN tests.trans_return AS h ON h.trans_return_id = d.trans_return_id AND h.remove IS FALSE\r\n    INNER JOIN tests.mstr_return_kind AS k ON k.mstr_return_kind_id = h.return_kind_id AND k.receive IS FALSE\r\n    WHERE d.trans_purchase_detail_id = pd.trans_purchase_detail_id AND d.remove IS FALSE\r\n) AS rt ON TRUE\r\nWHERE pd.remove IS FALSE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3867,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_order_detail_balance",
      "comment": "@primaryKey trans_order_detail_id\n@unique symbol\n@foreignKey (trans_order_detail_id) references trans_order_detail (trans_order_detail_id)\n@foreignKey (trans_order_id) references trans_order (trans_order_id)\n@foreignKey (item_id) references mstr_item (mstr_item_id)\n受注明細の残",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 受注明細の残 (MRP の需要の数え方)  claude/131\r\n-- remaining_quantity : 数量 − キャンセル数量 − 出荷済み ＋ 代品ありの返品\r\n-- open_quantity      : 停止中は 0 (MRP は停止中の受注明細を凍結する)\r\n-- cancel_closed      : キャンセル数量 > 0 かつ 残 0 (全部キャンセル済み)\r\n-- settlement_amount  : 途中精算の合計 (受注金額に加える。精算1件 = 請求書1行)\r\n-- 返品は入出庫判定区分マスタの receive = true (顧客からの返品) だけを数える\r\nSELECT\r\n    od.trans_order_detail_id\r\n    , od.symbol\r\n    , od.trans_order_id\r\n    , od.item_id\r\n    , od.stop\r\n    , od.customer_property\r\n    , od.quantity\r\n    , od.cancel_quantity\r\n    , COALESCE(sh.q, 0) AS shipped_quantity\r\n    , COALESCE(rt.q, 0) AS returned_quantity\r\n    , COALESCE(rt.q_rep, 0) AS replacement_quantity\r\n    , GREATEST(od.quantity - od.cancel_quantity - COALESCE(sh.q, 0) + COALESCE(rt.q_rep, 0), 0) AS remaining_quantity\r\n    , CASE WHEN od.stop THEN 0\r\n           ELSE GREATEST(od.quantity - od.cancel_quantity - COALESCE(sh.q, 0) + COALESCE(rt.q_rep, 0), 0) END AS open_quantity\r\n    , (od.cancel_quantity > 0\r\n       AND od.quantity - od.cancel_quantity - COALESCE(sh.q, 0) + COALESCE(rt.q_rep, 0) <= 0) AS cancel_closed\r\n    , COALESCE(st.amount, 0) AS settlement_amount\r\nFROM tests.trans_order_detail AS od\r\nLEFT JOIN LATERAL (\r\n    SELECT SUM(r.shipping_quantity) AS q\r\n    FROM tests.trans_shipping_order_detail AS sd\r\n    INNER JOIN tests.trans_shipping_order_detail_record AS r\r\n        ON r.trans_shipping_order_detail_id = sd.trans_shipping_order_detail_id AND r.remove IS FALSE\r\n    WHERE sd.trans_order_detail_id = od.trans_order_detail_id AND sd.remove IS FALSE\r\n) AS sh ON TRUE\r\nLEFT JOIN LATERAL (\r\n    SELECT SUM(d.quantity) AS q, SUM(d.quantity) FILTER (WHERE d.replacement) AS q_rep\r\n    FROM tests.trans_return_detail AS d\r\n    INNER JOIN tests.trans_return AS h ON h.trans_return_id = d.trans_return_id AND h.remove IS FALSE\r\n    INNER JOIN tests.mstr_return_kind AS k ON k.mstr_return_kind_id = h.return_kind_id AND k.receive IS TRUE\r\n    WHERE d.trans_order_detail_id = od.trans_order_detail_id AND d.remove IS FALSE\r\n) AS rt ON TRUE\r\nLEFT JOIN LATERAL (\r\n    SELECT SUM(s.amount) AS amount FROM tests.trans_order_detail_settlement AS s\r\n    WHERE s.trans_order_detail_id = od.trans_order_detail_id AND s.remove IS FALSE\r\n) AS st ON TRUE\r\nWHERE od.remove IS FALSE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3868,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_complaint_visiter_count",
      "comment": "@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@unique trans_visiter_id",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    p.trans_visiter_id\r\n    , COUNT(c.trans_visiter_id) AS all_count\r\n    , COUNT(c.trans_visiter_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\r\n    , COUNT(c.trans_visiter_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\r\nFROM\r\n    tests.trans_visiter AS p\r\n    LEFT JOIN tests.trans_complaint_visiter AS c\r\n        ON c.trans_visiter_id = p.trans_visiter_id\r\nGROUP BY\r\n    p.trans_visiter_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3869,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_complaint_complaint_visiter_count",
      "comment": "@foreignKey (trans_complaint_id) references trans_complaint (trans_complaint_id)\n@unique trans_complaint_id",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    p.trans_complaint_id\r\n    , COUNT(c.trans_complaint_id) AS all_count\r\n    , COUNT(c.trans_complaint_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\r\n    , COUNT(c.trans_complaint_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\r\nFROM\r\n    tests.trans_complaint AS p\r\n    LEFT JOIN tests.trans_complaint_visiter AS c\r\n        ON c.trans_complaint_id = p.trans_complaint_id\r\nGROUP BY\r\n    p.trans_complaint_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3870,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_lineage",
      "comment": "@primaryKey trans_visiter_id,ancestor_visiter_id\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (ancestor_visiter_id) references trans_visiter (trans_visiter_id)\n棚ビジターの分割元(自分を含む)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "WITH RECURSIVE lot AS (\r\n    SELECT v.trans_visiter_id, v.parent_trans_visiter_id\r\n    FROM tests.trans_visiter AS v\r\n    WHERE v.remove IS FALSE AND v.quantity > 0 AND v.adjustment IS NOT TRUE\r\n), l (trans_visiter_id, ancestor_visiter_id, parent_id, depth, path) AS (\r\n    SELECT lot.trans_visiter_id, lot.trans_visiter_id, lot.parent_trans_visiter_id, 0, ARRAY[lot.trans_visiter_id]\r\n    FROM lot\r\n    UNION ALL\r\n    SELECT l.trans_visiter_id, p.trans_visiter_id, p.parent_trans_visiter_id, l.depth + 1, l.path || p.trans_visiter_id\r\n    FROM l\r\n    INNER JOIN lot AS p ON p.trans_visiter_id = l.parent_id\r\n    WHERE NOT (p.trans_visiter_id = ANY (l.path)) AND l.depth < 50\r\n)\r\nSELECT\r\n    l.trans_visiter_id\r\n    , v.symbol\r\n    , l.ancestor_visiter_id\r\n    , a.symbol AS ancestor_symbol\r\n    , l.depth\r\nFROM l\r\nINNER JOIN tests.trans_visiter AS v ON v.trans_visiter_id = l.trans_visiter_id\r\nINNER JOIN tests.trans_visiter AS a ON a.trans_visiter_id = l.ancestor_visiter_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3871,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_lot",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (parent_trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (root_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n@foreignKey (mstr_location_id) references mstr_location (mstr_location_id)\n棚在庫(ロット)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    v.trans_visiter_id\r\n    , v.symbol\r\n    , v.parent_trans_visiter_id\r\n    , rt.root_visiter_id\r\n    , v.trans_container_id\r\n    , c.mstr_location_id\r\n    , v.release\r\n    , v.quantity AS receipt_quantity\r\n    , COALESCE(ln.q_issue, 0) AS issue_quantity\r\n    , COALESCE(ln.q_adj, 0) AS adjustment_quantity\r\n    , v.quantity + COALESCE(ln.q_all, 0) AS quantity\r\n    , COALESCE(ln.n, 0)::integer AS line_count\r\n    , COALESCE(sp.n, 0)::integer AS split_count\r\n    , cp.own_open_complaint_count\r\n    , cp.open_complaint_count\r\nFROM tests.trans_visiter AS v\r\nLEFT JOIN tests.trans_container AS c\r\n    ON c.trans_container_id = v.trans_container_id\r\nLEFT JOIN LATERAL (\r\n    -- この在庫の出庫(-)と棚卸し調整(+/-)の行\r\n    SELECT SUM(r.quantity) AS q_all\r\n         , -SUM(r.quantity) FILTER (WHERE r.adjustment IS NOT TRUE) AS q_issue\r\n         , SUM(r.quantity) FILTER (WHERE r.adjustment IS TRUE) AS q_adj\r\n         , COUNT(*) AS n\r\n    FROM tests.trans_visiter AS r\r\n    WHERE r.parent_trans_visiter_id = v.trans_visiter_id AND r.remove IS FALSE\r\n      AND (r.quantity < 0 OR r.adjustment IS TRUE)\r\n) AS ln ON TRUE\r\nLEFT JOIN LATERAL (\r\n    -- この在庫から分割・移動して作った在庫\r\n    SELECT COUNT(*) AS n\r\n    FROM tests.trans_visiter AS r\r\n    WHERE r.parent_trans_visiter_id = v.trans_visiter_id AND r.remove IS FALSE\r\n      AND r.quantity > 0 AND r.adjustment IS NOT TRUE\r\n) AS sp ON TRUE\r\nLEFT JOIN LATERAL (\r\n    SELECT lg.ancestor_visiter_id AS root_visiter_id\r\n    FROM tests.v_visiter_lineage AS lg\r\n    WHERE lg.trans_visiter_id = v.trans_visiter_id\r\n    ORDER BY lg.depth DESC\r\n    LIMIT 1\r\n) AS rt ON TRUE\r\nCROSS JOIN LATERAL (\r\n    -- 未解除の異常 (自分に付いたもの / 分割元に付いたものを含む)\r\n    SELECT COUNT(*) FILTER (WHERE lg.depth = 0)::integer AS own_open_complaint_count\r\n         , COUNT(*)::integer AS open_complaint_count\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_complaint_visiter AS cv\r\n        ON cv.trans_visiter_id = lg.ancestor_visiter_id AND cv.remove IS FALSE AND cv.release_at IS NULL\r\n    INNER JOIN tests.trans_complaint AS cpl\r\n        ON cpl.trans_complaint_id = cv.trans_complaint_id AND cpl.remove IS FALSE\r\n    WHERE lg.trans_visiter_id = v.trans_visiter_id\r\n) AS cp\r\nWHERE v.remove IS FALSE AND v.quantity > 0 AND v.adjustment IS NOT TRUE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3872,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_mrp_visiter_item",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (item_id) references mstr_item (mstr_item_id)\n棚ビジターの品目(在庫/仕掛)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "WITH og AS (\r\n    -- 品目は、自分または一番近い分割元の入庫のつなぎ(受入実績・作業実績・支給・返品)で決める\r\n    SELECT lg.trans_visiter_id, lg.depth, pd.item_id, TRUE AS finished\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_purchase_rec_visiter AS prv\r\n        ON prv.trans_visiter_id = lg.ancestor_visiter_id AND prv.remove IS FALSE\r\n    INNER JOIN tests.trans_purchase_rec AS r\r\n        ON r.trans_purchase_rec_id = prv.trans_purchase_rec_id AND r.remove IS FALSE\r\n    INNER JOIN tests.trans_purchase_detail AS pd\r\n        ON pd.trans_purchase_detail_id = r.trans_purchase_detail_id\r\n    WHERE NOT EXISTS (SELECT 1 FROM tests.trans_work_plan AS w\r\n                      WHERE w.trans_purchase_detail_id = pd.trans_purchase_detail_id AND w.remove IS FALSE)\r\n    UNION ALL\r\n    SELECT lg.trans_visiter_id, lg.depth, rp.item_id,\r\n           COALESCE(wp.sequence, 1) >= (SELECT MAX(COALESCE(w2.sequence, 1)) FROM tests.trans_work_plan AS w2\r\n                                        WHERE w2.trans_operations_plan_id = wp.trans_operations_plan_id AND w2.remove IS FALSE)\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_work_record_visiter AS wrv\r\n        ON wrv.trans_visiter_id = lg.ancestor_visiter_id AND wrv.remove IS FALSE\r\n    INNER JOIN tests.trans_work_record AS wr\r\n        ON wr.trans_work_record_id = wrv.trans_work_record_id AND wr.remove IS FALSE\r\n    INNER JOIN tests.trans_work_plan AS wp ON wp.trans_work_plan_id = wr.trans_work_plan_id\r\n    INNER JOIN tests.trans_operations_plan AS op ON op.trans_operations_plan_id = wp.trans_operations_plan_id\r\n    INNER JOIN tests.trans_resource_plan AS rp ON rp.trans_resource_plan_id = op.trans_resource_plan_id\r\n    UNION ALL\r\n    -- 支給で入庫した在庫 (顧客支給材・発注先からの戻り)。入庫の行(分割元の無い + の行)だけ  claude/131\r\n    SELECT lg.trans_visiter_id, lg.depth, sd.item_id, TRUE\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_supply_visiter AS sv\r\n        ON sv.trans_visiter_id = lg.ancestor_visiter_id AND sv.remove IS FALSE\r\n    INNER JOIN tests.trans_visiter AS av\r\n        ON av.trans_visiter_id = sv.trans_visiter_id AND av.quantity > 0 AND av.parent_trans_visiter_id IS NULL\r\n    INNER JOIN tests.trans_supply_detail AS sd\r\n        ON sd.trans_supply_detail_id = sv.trans_supply_detail_id AND sd.remove IS FALSE\r\n    UNION ALL\r\n    -- 返品で入庫した在庫 (顧客からの返品)。入庫の行だけ  claude/131\r\n    SELECT lg.trans_visiter_id, lg.depth, rd.item_id, TRUE\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_return_visiter AS rv\r\n        ON rv.trans_visiter_id = lg.ancestor_visiter_id AND rv.remove IS FALSE\r\n    INNER JOIN tests.trans_visiter AS av\r\n        ON av.trans_visiter_id = rv.trans_visiter_id AND av.quantity > 0 AND av.parent_trans_visiter_id IS NULL\r\n    INNER JOIN tests.trans_return_detail AS rd\r\n        ON rd.trans_return_detail_id = rv.trans_return_detail_id AND rd.remove IS FALSE\r\n), nearest AS (\r\n    SELECT og.*, MIN(og.depth) OVER (PARTITION BY og.trans_visiter_id) AS min_depth\r\n    FROM og\r\n)\r\nSELECT\r\n    l.trans_visiter_id\r\n    , l.symbol\r\n    , MIN(n.item_id::text)::uuid AS item_id\r\n    , COUNT(DISTINCT n.item_id)::integer AS item_count\r\n    , COALESCE(BOOL_OR(n.finished), FALSE) AS finished\r\n    , l.quantity\r\n    , l.release\r\n    , l.open_complaint_count\r\n    , (l.release IS NOT TRUE OR l.open_complaint_count > 0) AS held\r\nFROM tests.v_visiter_lot AS l\r\nINNER JOIN tests.trans_container AS c\r\n    ON c.trans_container_id = l.trans_container_id AND c.remove IS FALSE\r\nLEFT JOIN nearest AS n\r\n    ON n.trans_visiter_id = l.trans_visiter_id AND n.depth = n.min_depth\r\nGROUP BY l.trans_visiter_id, l.symbol, l.quantity, l.release, l.open_complaint_count",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3873,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_issuable",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n棚ビジター取り出し可否",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    l.trans_visiter_id\r\n    , l.symbol\r\n    , l.trans_container_id\r\n    , l.quantity\r\n    , l.release\r\n    , l.open_complaint_count\r\n    , (l.release IS TRUE AND l.open_complaint_count = 0 AND l.quantity > 0) AS issuable\r\n    , (CASE\r\n           WHEN l.release IS NOT TRUE THEN 'hold'\r\n           WHEN l.open_complaint_count > 0 THEN 'complaint'\r\n           WHEN l.quantity <= 0 THEN 'empty'\r\n       END)::varchar(16) AS block_reason\r\nFROM tests.v_visiter_lot AS l",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3874,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_item_on_hand",
      "comment": "@primaryKey item_id\n@unique item_symbol\n@foreignKey (item_id) references mstr_item (mstr_item_id)\n品目別現在庫",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    vi.item_id\r\n    , i.symbol AS item_symbol\r\n    , i.code AS item_code\r\n    , SUM(vi.quantity) AS on_hand_quantity\r\n    , COALESCE(SUM(vi.quantity) FILTER (WHERE vi.held), 0) AS held_quantity\r\n    , COALESCE(SUM(vi.quantity) FILTER (WHERE NOT vi.held AND ow.trans_visiter_id IS NULL), 0) AS available_quantity\r\n    , COUNT(*) FILTER (WHERE vi.quantity > 0)::integer AS visiter_count\r\n    , COUNT(*) FILTER (WHERE vi.held AND vi.quantity > 0)::integer AS held_visiter_count\r\n    -- 社外(顧客・発注先)の所有物。現在庫には含むが、使える在庫(available_quantity)には数えない  claude/131\r\n    , COALESCE(SUM(vi.quantity) FILTER (WHERE ow.trans_visiter_id IS NOT NULL), 0) AS external_quantity\r\n    , COUNT(*) FILTER (WHERE ow.trans_visiter_id IS NOT NULL AND vi.quantity > 0)::integer AS external_visiter_count\r\nFROM tests.v_mrp_visiter_item AS vi\r\nINNER JOIN tests.mstr_item AS i ON i.mstr_item_id = vi.item_id\r\nLEFT JOIN tests.trans_visiter_owner AS ow\r\n    ON ow.trans_visiter_id = vi.trans_visiter_id AND ow.remove IS FALSE AND ow.owner_stakeholder_id IS NOT NULL\r\nWHERE vi.finished AND vi.item_count = 1 AND vi.item_id IS NOT NULL\r\nGROUP BY vi.item_id, i.symbol, i.code",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3875,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_hold_without_complaint",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n@foreignKey (mstr_location_id) references mstr_location (mstr_location_id)\n異常の登録が無い仮止め",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    l.trans_visiter_id\r\n    , l.symbol\r\n    , l.trans_container_id\r\n    , l.mstr_location_id\r\n    , l.quantity\r\n    , v.update_at AS hold_at\r\n    , v.update_user_id\r\nFROM tests.v_visiter_lot AS l\r\nINNER JOIN tests.trans_visiter AS v\r\n    ON v.trans_visiter_id = l.trans_visiter_id\r\nWHERE l.release IS NOT TRUE\r\n  AND NOT EXISTS (\r\n      SELECT 1\r\n      FROM tests.v_visiter_lineage AS lg\r\n      INNER JOIN tests.trans_complaint_visiter AS cv\r\n          ON cv.trans_visiter_id = lg.ancestor_visiter_id AND cv.remove IS FALSE\r\n      INNER JOIN tests.trans_complaint AS cp\r\n          ON cp.trans_complaint_id = cv.trans_complaint_id AND cp.remove IS FALSE\r\n      WHERE lg.trans_visiter_id = l.trans_visiter_id\r\n  )",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3876,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_ledger_issue",
      "comment": "@primaryKey trans_visiter_id,issue_kind\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (parent_trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n棚ビジターの行の不備",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- negative_balance  : 在庫の今の数量がマイナス(出しすぎ)\r\n-- orphan_line       : 出庫・棚卸しの行の親が無い、または親が在庫の行ではない\r\n-- invalid_parent    : 分割・移動で作った在庫の親が在庫の行ではない\r\n-- container_mismatch: 出庫・棚卸しの行の棚が、親の在庫の棚と違う\r\n-- zero_line         : 数量0の行\r\nSELECT\r\n    l.trans_visiter_id\r\n    , l.symbol\r\n    , 'negative_balance'::varchar(32) AS issue_kind\r\n    , l.receipt_quantity AS row_quantity\r\n    , l.quantity AS balance\r\n    , l.parent_trans_visiter_id\r\n    , l.trans_container_id\r\nFROM tests.v_visiter_lot AS l\r\nWHERE l.quantity < 0\r\nUNION ALL\r\nSELECT\r\n    r.trans_visiter_id\r\n    , r.symbol\r\n    , (CASE\r\n           WHEN r.quantity = 0 THEN 'zero_line'\r\n           WHEN r.quantity > 0 AND r.adjustment IS NOT TRUE THEN 'invalid_parent'\r\n           WHEN p.trans_visiter_id IS NULL OR p.quantity <= 0 OR p.adjustment IS TRUE THEN 'orphan_line'\r\n           ELSE 'container_mismatch'\r\n       END)::varchar(32)\r\n    , r.quantity\r\n    , NULL::decimal(10,2)\r\n    , r.parent_trans_visiter_id\r\n    , r.trans_container_id\r\nFROM tests.trans_visiter AS r\r\nLEFT JOIN tests.trans_visiter AS p\r\n    ON p.trans_visiter_id = r.parent_trans_visiter_id AND p.remove IS FALSE\r\nWHERE r.remove IS FALSE\r\n  AND (\r\n        r.quantity = 0\r\n     OR ((r.quantity < 0 OR r.adjustment IS TRUE)\r\n         AND (p.trans_visiter_id IS NULL OR p.quantity <= 0 OR p.adjustment IS TRUE\r\n              OR p.trans_container_id IS DISTINCT FROM r.trans_container_id))\r\n     OR (r.quantity > 0 AND r.adjustment IS NOT TRUE AND r.parent_trans_visiter_id IS NOT NULL\r\n         AND (p.trans_visiter_id IS NULL OR p.quantity <= 0 OR p.adjustment IS TRUE))\r\n  )",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3877,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_visiter_origin_check",
      "comment": "@primaryKey origin_kind,origin_id\n@foreignKey (trans_purchase_rec_id) references trans_purchase_rec (trans_purchase_rec_id)\n@foreignKey (trans_work_record_id) references trans_work_record (trans_work_record_id)\n入庫数量不一致(受入実績・作業実績)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    x.origin_kind\r\n    , x.origin_id\r\n    , x.origin_symbol\r\n    , x.trans_purchase_rec_id\r\n    , x.trans_work_record_id\r\n    , x.record_quantity\r\n    , x.visiter_quantity\r\n    , x.record_quantity - x.visiter_quantity AS difference\r\n    , x.visiter_count\r\nFROM (\r\n    SELECT\r\n        'purchase_rec'::varchar(16) AS origin_kind\r\n        , r.trans_purchase_rec_id AS origin_id\r\n        , r.symbol AS origin_symbol\r\n        , r.trans_purchase_rec_id\r\n        , NULL::uuid AS trans_work_record_id\r\n        , COALESCE(r.quantity, 0) AS record_quantity\r\n        , COALESCE(lt.q, 0) AS visiter_quantity\r\n        , COALESCE(lt.n, 0)::integer AS visiter_count\r\n    FROM tests.trans_purchase_rec AS r\r\n    LEFT JOIN LATERAL (\r\n        SELECT SUM(v.quantity) AS q, COUNT(*) AS n\r\n        FROM tests.trans_purchase_rec_visiter AS prv\r\n        INNER JOIN tests.trans_visiter AS v\r\n            ON v.trans_visiter_id = prv.trans_visiter_id AND v.remove IS FALSE\r\n           AND v.quantity > 0 AND v.adjustment IS NOT TRUE\r\n        WHERE prv.trans_purchase_rec_id = r.trans_purchase_rec_id AND prv.remove IS FALSE\r\n    ) AS lt ON TRUE\r\n    WHERE r.remove IS FALSE\r\n    UNION ALL\r\n    SELECT\r\n        'work_record'\r\n        , w.trans_work_record_id\r\n        , w.symbol\r\n        , NULL::uuid\r\n        , w.trans_work_record_id\r\n        , COALESCE(w.qty, 0)\r\n        , COALESCE(lt.q, 0)\r\n        , COALESCE(lt.n, 0)::integer\r\n    FROM tests.trans_work_record AS w\r\n    LEFT JOIN LATERAL (\r\n        SELECT SUM(v.quantity) AS q, COUNT(*) AS n\r\n        FROM tests.trans_work_record_visiter AS wrv\r\n        INNER JOIN tests.trans_visiter AS v\r\n            ON v.trans_visiter_id = wrv.trans_visiter_id AND v.remove IS FALSE\r\n           AND v.quantity > 0 AND v.adjustment IS NOT TRUE\r\n        WHERE wrv.trans_work_record_id = w.trans_work_record_id AND wrv.remove IS FALSE\r\n    ) AS lt ON TRUE\r\n    WHERE w.remove IS FALSE\r\n) AS x\r\nWHERE x.record_quantity <> x.visiter_quantity",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3878,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_complaint_target_visiter",
      "comment": "@primaryKey complaint_target_visiter_key\n@foreignKey (trans_complaint_id) references trans_complaint (trans_complaint_id)\n@foreignKey (trans_purchase_rec_id) references trans_purchase_rec (trans_purchase_rec_id)\n@foreignKey (trans_supply_detail_id) references trans_supply_detail (trans_supply_detail_id)\n@foreignKey (trans_work_record_id) references trans_work_record (trans_work_record_id)\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (trans_complaint_visiter_id) references trans_complaint_visiter (trans_complaint_visiter_id)\n異常の対象と棚ビジター",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "WITH tgt AS (\r\n    SELECT t.trans_complaint_id, 'purchase_rec'::varchar(16) AS target_kind, t.trans_complaint_purchase_rec_id AS target_link_id,\r\n           t.trans_purchase_rec_id, NULL::uuid AS trans_work_record_id, NULL::uuid AS target_visiter_id, t.quantity AS complaint_quantity,\r\n           NULL::uuid AS trans_supply_detail_id\r\n    FROM tests.trans_complaint_purchase_rec AS t\r\n    WHERE t.remove IS FALSE\r\n    UNION ALL\r\n    SELECT t.trans_complaint_id, 'work_record', t.trans_complaint_work_id,\r\n           NULL::uuid, t.trans_work_record_id, NULL::uuid, t.quantity, NULL::uuid\r\n    FROM tests.trans_complaint_work AS t\r\n    WHERE t.remove IS FALSE\r\n    UNION ALL\r\n    SELECT t.trans_complaint_id, 'visiter', t.trans_complaint_visiter_id,\r\n           NULL::uuid, NULL::uuid, t.trans_visiter_id, t.quantity, NULL::uuid\r\n    FROM tests.trans_complaint_visiter AS t\r\n    WHERE t.remove IS FALSE\r\n    UNION ALL\r\n    -- 支給品の検品で見つかった異常  claude/131\r\n    SELECT t.trans_complaint_id, 'supply', t.trans_complaint_supply_id,\r\n           NULL::uuid, NULL::uuid, NULL::uuid, t.quantity, t.trans_supply_detail_id\r\n    FROM tests.trans_complaint_supply AS t\r\n    WHERE t.remove IS FALSE\r\n), src AS (\r\n    -- 異常の対象から直接作られた在庫\r\n    SELECT tg.target_link_id, prv.trans_visiter_id\r\n    FROM tgt AS tg\r\n    INNER JOIN tests.trans_purchase_rec_visiter AS prv\r\n        ON prv.trans_purchase_rec_id = tg.trans_purchase_rec_id AND prv.remove IS FALSE\r\n    WHERE tg.target_kind = 'purchase_rec'\r\n    UNION\r\n    SELECT tg.target_link_id, wrv.trans_visiter_id\r\n    FROM tgt AS tg\r\n    INNER JOIN tests.trans_work_record_visiter AS wrv\r\n        ON wrv.trans_work_record_id = tg.trans_work_record_id AND wrv.remove IS FALSE\r\n    INNER JOIN tests.trans_visiter AS v\r\n        ON v.trans_visiter_id = wrv.trans_visiter_id AND v.quantity > 0\r\n    WHERE tg.target_kind = 'work_record'\r\n    UNION\r\n    SELECT tg.target_link_id, tg.target_visiter_id\r\n    FROM tgt AS tg\r\n    WHERE tg.target_kind = 'visiter'\r\n    UNION\r\n    SELECT tg.target_link_id, sv.trans_visiter_id\r\n    FROM tgt AS tg\r\n    INNER JOIN tests.trans_supply_visiter AS sv\r\n        ON sv.trans_supply_detail_id = tg.trans_supply_detail_id AND sv.remove IS FALSE\r\n    INNER JOIN tests.trans_visiter AS v\r\n        ON v.trans_visiter_id = sv.trans_visiter_id AND v.quantity > 0\r\n    WHERE tg.target_kind = 'supply'\r\n), dv AS (\r\n    -- その在庫と、そこから分割・移動して作った在庫\r\n    SELECT DISTINCT s.target_link_id, lg.trans_visiter_id\r\n    FROM src AS s\r\n    INNER JOIN tests.v_visiter_lineage AS lg ON lg.ancestor_visiter_id = s.trans_visiter_id\r\n)\r\nSELECT\r\n    md5(concat_ws('|', tg.target_kind, tg.target_link_id, iss.trans_visiter_id)) AS complaint_target_visiter_key\r\n    , tg.trans_complaint_id\r\n    , cp.symbol AS complaint_symbol\r\n    , tg.target_kind\r\n    , tg.target_link_id\r\n    , tg.trans_purchase_rec_id\r\n    , tg.trans_work_record_id\r\n    , tg.trans_supply_detail_id\r\n    , tg.complaint_quantity\r\n    , iss.trans_visiter_id\r\n    , iss.symbol AS visiter_symbol\r\n    , iss.quantity AS visiter_quantity\r\n    , iss.release\r\n    , lk.trans_complaint_visiter_id\r\n    , (lk.trans_complaint_visiter_id IS NOT NULL) AS linked\r\n    , lk.release_at\r\n    , (CASE\r\n           WHEN iss.trans_visiter_id IS NULL THEN NULL\r\n           WHEN iss.quantity <= 0 THEN 'empty'\r\n           WHEN NOT iss.issuable THEN 'held'\r\n           ELSE 'issuable'\r\n       END)::varchar(16) AS visiter_status\r\nFROM tgt AS tg\r\nINNER JOIN tests.trans_complaint AS cp\r\n    ON cp.trans_complaint_id = tg.trans_complaint_id AND cp.remove IS FALSE\r\nLEFT JOIN dv ON dv.target_link_id = tg.target_link_id\r\nLEFT JOIN tests.v_visiter_issuable AS iss\r\n    ON iss.trans_visiter_id = dv.trans_visiter_id\r\nLEFT JOIN LATERAL (\r\n    -- 同じ異常が、自分か分割元に付いているか\r\n    SELECT cv.trans_complaint_visiter_id, cv.release_at\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_complaint_visiter AS cv\r\n        ON cv.trans_visiter_id = lg.ancestor_visiter_id\r\n       AND cv.trans_complaint_id = tg.trans_complaint_id AND cv.remove IS FALSE\r\n    WHERE lg.trans_visiter_id = iss.trans_visiter_id\r\n    ORDER BY cv.release_at NULLS FIRST, lg.depth\r\n    LIMIT 1\r\n) AS lk ON TRUE\r\nWHERE dv.trans_visiter_id IS NULL OR iss.trans_visiter_id IS NOT NULL",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3879,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_complaint_target",
      "comment": "@primaryKey target_link_id\n@foreignKey (trans_complaint_id) references trans_complaint (trans_complaint_id)\n@foreignKey (trans_purchase_rec_id) references trans_purchase_rec (trans_purchase_rec_id)\n@foreignKey (trans_supply_detail_id) references trans_supply_detail (trans_supply_detail_id)\n@foreignKey (trans_work_record_id) references trans_work_record (trans_work_record_id)\n異常の対象",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    t.target_link_id\r\n    , t.trans_complaint_id\r\n    , t.complaint_symbol\r\n    , t.target_kind\r\n    , t.trans_purchase_rec_id\r\n    , t.trans_work_record_id\r\n    , t.trans_supply_detail_id\r\n    , t.complaint_quantity\r\n    , COUNT(t.trans_visiter_id)::integer AS visiter_count\r\n    , COALESCE(SUM(t.visiter_quantity), 0) AS visiter_quantity\r\n    , COUNT(*) FILTER (WHERE t.linked)::integer AS linked_count\r\n    , COUNT(*) FILTER (WHERE t.linked AND t.release_at IS NULL)::integer AS open_count\r\n    , COUNT(*) FILTER (WHERE t.trans_visiter_id IS NOT NULL AND NOT t.linked)::integer AS missing_count\r\n    , COUNT(*) FILTER (WHERE t.trans_visiter_id IS NOT NULL AND NOT t.linked AND t.visiter_status = 'issuable')::integer AS missing_issuable_count\r\n    , COUNT(*) FILTER (WHERE t.trans_visiter_id IS NOT NULL AND NOT t.linked AND t.visiter_status = 'empty')::integer AS missing_empty_count\r\nFROM tests.v_complaint_target_visiter AS t\r\nGROUP BY t.target_link_id, t.trans_complaint_id, t.complaint_symbol, t.target_kind, t.trans_purchase_rec_id, t.trans_work_record_id, t.trans_supply_detail_id, t.complaint_quantity",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3880,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_shelf_inventory_status",
      "comment": "@primaryKey trans_visiter_id\n@unique symbol\n@foreignKey (trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (parent_trans_visiter_id) references trans_visiter (trans_visiter_id)\n@foreignKey (trans_container_id) references trans_container (trans_container_id)\n@foreignKey (mstr_location_id) references mstr_location (mstr_location_id)\n棚在庫状況",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "-- 6. 棚在庫状況 (2026-11-01 改訂: 数量は棚ビジターだけ。1行 = 在庫(ロット) 1件)\r\n-- フィルタ: 受入実績(trans_purchase_rec_ids ※配列・分割元を含む), 作業実績(trans_work_record_ids ※配列・分割元を含む),\r\n--           投入先の作業実績(consumed_work_record_ids ※配列), 受払実績(trans_convey_ids ※配列),\r\n--           入出庫許可(release), 今の数量(quantity), コンテナID(trans_container_id), 場所ID(mstr_location_id)\r\nSELECT\r\n    l.trans_visiter_id\r\n    , l.symbol\r\n    , l.parent_trans_visiter_id\r\n    , l.root_visiter_id\r\n    , l.trans_container_id\r\n    , l.mstr_location_id\r\n    , l.release\r\n    , l.quantity\r\n    , l.receipt_quantity\r\n    , l.issue_quantity\r\n    , l.adjustment_quantity\r\n    , l.line_count\r\n    , l.split_count\r\n    , l.open_complaint_count\r\n    , COALESCE(pr.ids, ARRAY[]::uuid[]) AS trans_purchase_rec_ids\r\n    , COALESCE(pr.n, 0)::integer AS purchase_rec_count\r\n    , COALESCE(wr.ids, ARRAY[]::uuid[]) AS trans_work_record_ids\r\n    , COALESCE(wr.n, 0)::integer AS work_record_count\r\n    , COALESCE(us.ids, ARRAY[]::uuid[]) AS consumed_work_record_ids\r\n    , COALESCE(us.n, 0)::integer AS consumed_work_record_count\r\n    , COALESCE(cv.ids, ARRAY[]::uuid[]) AS trans_convey_ids\r\n    , COALESCE(cv.n, 0)::integer AS convey_count\r\n    , cv.last_at AS last_convey_at\r\nFROM tests.v_visiter_lot AS l\r\nINNER JOIN tests.trans_container AS c\r\n    ON c.trans_container_id = l.trans_container_id AND c.remove IS FALSE\r\nLEFT JOIN LATERAL (\r\n    SELECT ARRAY_AGG(DISTINCT prv.trans_purchase_rec_id) AS ids, COUNT(DISTINCT prv.trans_purchase_rec_id) AS n\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_purchase_rec_visiter AS prv\r\n        ON prv.trans_visiter_id = lg.ancestor_visiter_id AND prv.remove IS FALSE\r\n    INNER JOIN tests.trans_purchase_rec AS r\r\n        ON r.trans_purchase_rec_id = prv.trans_purchase_rec_id AND r.remove IS FALSE\r\n    WHERE lg.trans_visiter_id = l.trans_visiter_id\r\n) AS pr ON TRUE\r\nLEFT JOIN LATERAL (\r\n    SELECT ARRAY_AGG(DISTINCT wrv.trans_work_record_id) AS ids, COUNT(DISTINCT wrv.trans_work_record_id) AS n\r\n    FROM tests.v_visiter_lineage AS lg\r\n    INNER JOIN tests.trans_work_record_visiter AS wrv\r\n        ON wrv.trans_visiter_id = lg.ancestor_visiter_id AND wrv.remove IS FALSE\r\n    INNER JOIN tests.trans_work_record AS w\r\n        ON w.trans_work_record_id = wrv.trans_work_record_id AND w.remove IS FALSE\r\n    WHERE lg.trans_visiter_id = l.trans_visiter_id\r\n) AS wr ON TRUE\r\nLEFT JOIN LATERAL (\r\n    -- この在庫から材料として投入した作業実績 (出庫の行につながる作業実績)\r\n    SELECT ARRAY_AGG(DISTINCT wrv.trans_work_record_id) AS ids, COUNT(DISTINCT wrv.trans_work_record_id) AS n\r\n    FROM tests.trans_visiter AS r\r\n    INNER JOIN tests.trans_work_record_visiter AS wrv\r\n        ON wrv.trans_visiter_id = r.trans_visiter_id AND wrv.remove IS FALSE\r\n    INNER JOIN tests.trans_work_record AS w\r\n        ON w.trans_work_record_id = wrv.trans_work_record_id AND w.remove IS FALSE\r\n    WHERE r.parent_trans_visiter_id = l.trans_visiter_id AND r.remove IS FALSE AND r.quantity < 0\r\n) AS us ON TRUE\r\nLEFT JOIN LATERAL (\r\n    -- この在庫の行と、その出庫・棚卸しの行の受払実績\r\n    SELECT ARRAY_AGG(cn.trans_convey_id ORDER BY cn.convey_at, cn.trans_convey_id) AS ids, COUNT(*) AS n, MAX(cn.convey_at) AS last_at\r\n    FROM tests.trans_convey AS cn\r\n    INNER JOIN tests.trans_visiter AS r\r\n        ON r.trans_visiter_id = cn.trans_visiter_id AND r.remove IS FALSE\r\n    WHERE cn.remove IS FALSE\r\n      AND (r.trans_visiter_id = l.trans_visiter_id\r\n           OR (r.parent_trans_visiter_id = l.trans_visiter_id AND (r.quantity < 0 OR r.adjustment IS TRUE)))\r\n) AS cv ON TRUE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3881,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_work_plan_delivery_compliance",
      "comment": "@primaryKey trans_work_plan_id\n@foreignKey (trans_work_plan_id) references trans_work_plan (trans_work_plan_id)\n@foreignKey (trans_operations_plan_id) references trans_operations_plan (trans_operations_plan_id)\n@foreignKey (mstr_task_id) references mstr_task (mstr_task_id)\n生産計画納期遵守状況",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    x.trans_work_plan_id\r\n    , x.trans_operations_plan_id\r\n    , x.mstr_task_id\r\n    , x.start_at\r\n    , x.completion_at\r\n    , x.deadline\r\n    , x.trans_work_record_ids\r\n    , x.work_record_count\r\n    , x.planned_quantity\r\n    , x.work_quantity\r\n    , x.is_completed\r\n    , x.first_start_at\r\n    , CASE WHEN x.is_completed THEN x.last_stop_at END AS completed_at\r\n    , CASE\r\n        WHEN x.is_completed AND x.completion_at IS NULL THEN 'NO_DEADLINE'\r\n        WHEN x.is_completed AND x.last_stop_at <= x.completion_at THEN 'ON_TIME'\r\n        WHEN x.is_completed THEN 'LATE'\r\n        WHEN x.completion_at < CURRENT_TIMESTAMP THEN 'OVERDUE'\r\n        ELSE 'PENDING'\r\n      END AS compliance_status\r\nFROM\r\n    (\r\n        SELECT\r\n            wp.trans_work_plan_id\r\n            , wp.trans_operations_plan_id\r\n            , wp.mstr_task_id\r\n            , wp.start_at\r\n            , wp.completion_at\r\n            , op.deadline\r\n            , COALESCE(wr.trans_work_record_ids, ARRAY[]::UUID[]) AS trans_work_record_ids\r\n            , COALESCE(wr.work_record_count, 0) AS work_record_count\r\n            , rp.quantity AS planned_quantity\r\n            , COALESCE(wr.work_quantity, 0) AS work_quantity\r\n            , CASE\r\n                WHEN rp.quantity IS NOT NULL THEN COALESCE(wr.work_quantity, 0) >= rp.quantity\r\n                ELSE COALESCE(wr.work_record_count, 0) > 0\r\n              END AS is_completed\r\n            , wr.first_start_at\r\n            , wr.last_stop_at\r\n        FROM\r\n            tests.trans_work_plan AS wp\r\n            INNER JOIN tests.trans_operations_plan AS op\r\n                ON op.trans_operations_plan_id = wp.trans_operations_plan_id\r\n                AND op.remove IS FALSE\r\n            INNER JOIN tests.mstr_task AS t\r\n                ON t.mstr_task_id = wp.mstr_task_id\r\n                AND t.remove IS FALSE\r\n            LEFT JOIN tests.trans_resource_plan AS rp\r\n                ON rp.trans_resource_plan_id = op.trans_resource_plan_id\r\n                AND rp.remove IS FALSE\r\n            LEFT JOIN LATERAL (\r\n                SELECT\r\n                    ARRAY_AGG(w.trans_work_record_id ORDER BY w.nth_time, w.start_at) AS trans_work_record_ids\r\n                    , COUNT(w.trans_work_record_id) AS work_record_count\r\n                    , SUM(w.qty) AS work_quantity\r\n                    , MIN(w.start_at) AS first_start_at\r\n                    , MAX(w.stop_at) AS last_stop_at\r\n                FROM\r\n                    tests.trans_work_record AS w\r\n                WHERE\r\n                    w.trans_work_plan_id = wp.trans_work_plan_id\r\n                    AND w.remove IS FALSE\r\n            ) AS wr\r\n                ON TRUE\r\n        WHERE\r\n            wp.remove IS FALSE\r\n    ) AS x",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3882,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_inspection_status",
      "comment": "@foreignKey (mstr_equipment_id) references mstr_equipment (mstr_equipment_id)\n@foreignKey (supplier_id) references mstr_stakeholder (mstr_stakeholder_id)\n点検整備実施状況",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    e.mstr_equipment_id\r\n    , st.mstr_stakeholder_id AS supplier_id\r\n    , (rc.trans_inspect_record_id IS NOT NULL) AS is_implemented\r\n    , rc.result\r\n    , COUNT(sd.trans_inspect_sch_detail_id) AS schedule_detail_count\r\n    , COUNT(sd.trans_inspect_sch_detail_id) FILTER (WHERE rc.trans_inspect_record_id IS NULL AND sd.scheduled_end_date < CURRENT_TIMESTAMP) AS overdue_count\r\n    , MIN(sd.scheduled_start_date) FILTER (WHERE rc.trans_inspect_record_id IS NULL) AS next_scheduled_start_date\r\n    , MAX(rc.implement_stop_date) AS last_implement_date\r\nFROM\r\n    tests.trans_inspect_sch_detail AS sd\r\n    INNER JOIN tests.trans_inspect_sch AS s\r\n        ON s.trans_inspect_sch_id = sd.trans_inspect_sch_id\r\n        AND s.remove IS FALSE\r\n    INNER JOIN tests.mstr_equipment AS e\r\n        ON e.mstr_equipment_id = s.equipment_id\r\n        AND e.remove IS FALSE\r\n    LEFT JOIN tests.mstr_stakeholder AS st\r\n        ON st.mstr_stakeholder_id = sd.stakeholder_id\r\n        AND st.remove IS FALSE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            r.trans_inspect_record_id\r\n            , r.result\r\n            , r.implement_stop_date\r\n        FROM\r\n            tests.trans_inspect_record AS r\r\n        WHERE\r\n            r.trans_inspect_sch_detail_id = sd.trans_inspect_sch_detail_id\r\n            AND r.remove IS FALSE\r\n        ORDER BY\r\n            r.implement_stop_date DESC NULLS LAST\r\n            , r.update_at DESC\r\n        LIMIT 1\r\n    ) AS rc\r\n        ON TRUE\r\nWHERE\r\n    sd.remove IS FALSE\r\nGROUP BY\r\n    e.mstr_equipment_id\r\n    , st.mstr_stakeholder_id\r\n    , (rc.trans_inspect_record_id IS NOT NULL)\r\n    , rc.result",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3883,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_shipping_delivery_compliance",
      "comment": "@foreignKey (customer_id) references mstr_stakeholder (mstr_stakeholder_id)\n@foreignKey (mstr_item_kind_id) references mstr_item_kind (mstr_item_kind_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n出荷納期遵守状況",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    x.customer_id\r\n    , x.mstr_item_kind_id\r\n    , x.mstr_item_id\r\n    , x.mstr_item_provision_ids\r\n    , x.delivery_date\r\n    , x.estimated_shipping_date\r\n    , x.shipping_date\r\n    , COUNT(*) AS shipping_detail_count\r\n    , COUNT(*) FILTER (WHERE x.is_shipped AND x.shipping_date <= x.delivery_date) AS on_time_count\r\n    , COUNT(*) FILTER (WHERE x.is_shipped AND x.shipping_date > x.delivery_date) AS late_count\r\n    , COUNT(*) FILTER (WHERE NOT x.is_shipped AND x.delivery_date < CURRENT_DATE) AS overdue_count\r\n    , COUNT(*) FILTER (WHERE NOT x.is_shipped AND (x.delivery_date >= CURRENT_DATE OR x.delivery_date IS NULL)) AS pending_count\r\n    , COUNT(*) FILTER (WHERE x.is_shipped AND x.shipping_date <= x.estimated_shipping_date) AS schedule_kept_count\r\n    , COUNT(*) FILTER (WHERE x.is_shipped AND x.shipping_date > x.estimated_shipping_date) AS schedule_missed_count\r\n    , SUM(x.scheduled_quantity) AS scheduled_quantity\r\n    , SUM(x.shipped_quantity) AS shipped_quantity\r\nFROM\r\n    (\r\n        SELECT\r\n            o.stakeholder_id AS customer_id\r\n            , i.mstr_item_kind_id\r\n            , i.mstr_item_id\r\n            , pr.mstr_item_provision_ids\r\n            , COALESCE(od.delivery_date, o.delivery_date)::DATE AS delivery_date\r\n            , COALESCE(sd.estimated_shipping_date, so.estimated_shipping_date)::DATE AS estimated_shipping_date\r\n            , rc.last_shipping_date::DATE AS shipping_date\r\n            , sd.shipping_quantity AS scheduled_quantity\r\n            , COALESCE(rc.shipped_quantity, 0) AS shipped_quantity\r\n            , (COALESCE(rc.shipped_quantity, 0) >= sd.shipping_quantity) AS is_shipped\r\n        FROM\r\n            tests.trans_shipping_order_detail AS sd\r\n            INNER JOIN tests.trans_shipping_order AS so\r\n                ON so.trans_shipping_order_id = sd.trans_shipping_order_id\r\n                AND so.remove IS FALSE\r\n            INNER JOIN tests.trans_order_detail AS od\r\n                ON od.trans_order_detail_id = sd.trans_order_detail_id\r\n                AND od.remove IS FALSE\r\n            INNER JOIN tests.trans_order AS o\r\n                ON o.trans_order_id = od.trans_order_id\r\n                AND o.remove IS FALSE\r\n            INNER JOIN tests.mstr_stakeholder AS c\r\n                ON c.mstr_stakeholder_id = o.stakeholder_id\r\n                AND c.remove IS FALSE\r\n            INNER JOIN tests.mstr_item AS i\r\n                ON i.mstr_item_id = od.item_id\r\n                AND i.remove IS FALSE\r\n            INNER JOIN tests.mstr_item_kind AS k\r\n                ON k.mstr_item_kind_id = i.mstr_item_kind_id\r\n                AND k.remove IS FALSE\r\n            LEFT JOIN LATERAL (\r\n                SELECT\r\n                    ARRAY_AGG(ip.mstr_item_provision_id ORDER BY ip.mstr_item_provision_id) AS mstr_item_provision_ids\r\n                FROM\r\n                    tests.mstr_item_provision AS ip\r\n                    INNER JOIN tests.info_provision AS pv\r\n                        ON pv.info_provision_id = ip.info_provision_id\r\n                        AND pv.remove IS FALSE\r\n                WHERE\r\n                    ip.mstr_item_id = i.mstr_item_id\r\n                    AND ip.remove IS FALSE\r\n            ) AS pr\r\n                ON TRUE\r\n            LEFT JOIN LATERAL (\r\n                SELECT\r\n                    SUM(r.shipping_quantity) AS shipped_quantity\r\n                    , MAX(r.shipping_date) AS last_shipping_date\r\n                FROM\r\n                    tests.trans_shipping_order_detail_record AS r\r\n                WHERE\r\n                    r.trans_shipping_order_detail_id = sd.trans_shipping_order_detail_id\r\n                    AND r.remove IS FALSE\r\n            ) AS rc\r\n                ON TRUE\r\n        WHERE\r\n            sd.remove IS FALSE\r\n    ) AS x\r\nGROUP BY\r\n    x.customer_id\r\n    , x.mstr_item_kind_id\r\n    , x.mstr_item_id\r\n    , x.mstr_item_provision_ids\r\n    , x.delivery_date\r\n    , x.estimated_shipping_date\r\n    , x.shipping_date",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3884,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_shipping_order_status",
      "comment": "@foreignKey (customer_id) references mstr_stakeholder (mstr_stakeholder_id)\n@foreignKey (mstr_item_kind_id) references mstr_item_kind (mstr_item_kind_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n出荷予定受注実績状況",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    o.stakeholder_id AS customer_id\r\n    , i.mstr_item_kind_id\r\n    , i.mstr_item_id\r\n    , pr.mstr_item_provision_ids\r\n    , COALESCE(od.delivery_date, o.delivery_date)::DATE AS delivery_date\r\n    , COALESCE(sd.estimated_shipping_date, so.estimated_shipping_date)::DATE AS estimated_shipping_date\r\n    , rc.last_shipping_date::DATE AS shipping_date\r\n    , COUNT(sd.trans_shipping_order_detail_id) AS shipping_detail_count\r\n    , COUNT(sd.trans_shipping_order_detail_id) FILTER (WHERE COALESCE(rc.shipped_quantity, 0) >= sd.shipping_quantity) AS shipped_detail_count\r\n    , SUM(sd.shipping_quantity) AS scheduled_quantity\r\n    , SUM(COALESCE(rc.shipped_quantity, 0)) AS shipped_quantity\r\n    , SUM(GREATEST(sd.shipping_quantity - COALESCE(rc.shipped_quantity, 0), 0)) AS remaining_quantity\r\n    , ROUND(SUM((sd.shipping_quantity) * COALESCE(od.fixed_price, od.unit_price, 0) + COALESCE(od.price_adjustment, 0) * COALESCE((sd.shipping_quantity) / NULLIF(od.quantity, 0), 0)), 2) AS scheduled_amount\r\n    , ROUND(SUM((COALESCE(rc.shipped_quantity, 0)) * COALESCE(od.fixed_price, od.unit_price, 0) + COALESCE(od.price_adjustment, 0) * COALESCE((COALESCE(rc.shipped_quantity, 0)) / NULLIF(od.quantity, 0), 0)), 2) AS shipped_amount\r\nFROM\r\n    tests.trans_shipping_order_detail AS sd\r\n    INNER JOIN tests.trans_shipping_order AS so\r\n        ON so.trans_shipping_order_id = sd.trans_shipping_order_id\r\n        AND so.remove IS FALSE\r\n    INNER JOIN tests.trans_order_detail AS od\r\n        ON od.trans_order_detail_id = sd.trans_order_detail_id\r\n        AND od.remove IS FALSE\r\n    INNER JOIN tests.trans_order AS o\r\n        ON o.trans_order_id = od.trans_order_id\r\n        AND o.remove IS FALSE\r\n    INNER JOIN tests.mstr_stakeholder AS c\r\n        ON c.mstr_stakeholder_id = o.stakeholder_id\r\n        AND c.remove IS FALSE\r\n    INNER JOIN tests.mstr_item AS i\r\n        ON i.mstr_item_id = od.item_id\r\n        AND i.remove IS FALSE\r\n    INNER JOIN tests.mstr_item_kind AS k\r\n        ON k.mstr_item_kind_id = i.mstr_item_kind_id\r\n        AND k.remove IS FALSE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            ARRAY_AGG(ip.mstr_item_provision_id ORDER BY ip.mstr_item_provision_id) AS mstr_item_provision_ids\r\n        FROM\r\n            tests.mstr_item_provision AS ip\r\n            INNER JOIN tests.info_provision AS pv\r\n                ON pv.info_provision_id = ip.info_provision_id\r\n                AND pv.remove IS FALSE\r\n        WHERE\r\n            ip.mstr_item_id = i.mstr_item_id\r\n            AND ip.remove IS FALSE\r\n    ) AS pr\r\n        ON TRUE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            SUM(r.shipping_quantity) AS shipped_quantity\r\n            , MAX(r.shipping_date) AS last_shipping_date\r\n        FROM\r\n            tests.trans_shipping_order_detail_record AS r\r\n        WHERE\r\n            r.trans_shipping_order_detail_id = sd.trans_shipping_order_detail_id\r\n            AND r.remove IS FALSE\r\n    ) AS rc\r\n        ON TRUE\r\nWHERE\r\n    sd.remove IS FALSE\r\nGROUP BY\r\n    o.stakeholder_id\r\n    , i.mstr_item_kind_id\r\n    , i.mstr_item_id\r\n    , pr.mstr_item_provision_ids\r\n    , COALESCE(od.delivery_date, o.delivery_date)::DATE\r\n    , COALESCE(sd.estimated_shipping_date, so.estimated_shipping_date)::DATE\r\n    , rc.last_shipping_date::DATE",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3885,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_purchase_delivery_compliance",
      "comment": "@foreignKey (supplier_id) references mstr_stakeholder (mstr_stakeholder_id)\n@foreignKey (mstr_item_kind_id) references mstr_item_kind (mstr_item_kind_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n発注納期遵守状況",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    x.supplier_id\r\n    , x.mstr_item_kind_id\r\n    , x.mstr_item_id\r\n    , x.mstr_item_provision_ids\r\n    , x.period\r\n    , x.is_received\r\n    , COUNT(*) AS purchase_detail_count\r\n    , COUNT(*) FILTER (WHERE x.is_received AND x.received_date <= x.period) AS on_time_count\r\n    , COUNT(*) FILTER (WHERE x.is_received AND x.received_date > x.period) AS late_count\r\n    , COUNT(*) FILTER (WHERE NOT x.is_received AND x.period < CURRENT_DATE) AS overdue_count\r\n    , COUNT(*) FILTER (WHERE NOT x.is_received AND (x.period >= CURRENT_DATE OR x.period IS NULL)) AS pending_count\r\n    , SUM(x.purchase_quantity) AS purchase_quantity\r\n    , SUM(x.received_quantity) AS received_quantity\r\nFROM\r\n    (\r\n        SELECT\r\n            p.stakeholder_id AS supplier_id\r\n            , i.mstr_item_kind_id\r\n            , i.mstr_item_id\r\n            , pr.mstr_item_provision_ids\r\n            , pd.period::DATE AS period\r\n            , COALESCE(pd.quantity, 0) AS purchase_quantity\r\n            , COALESCE(rc.received_quantity, 0) AS received_quantity\r\n            , (COALESCE(rc.received_quantity, 0) >= COALESCE(pd.quantity, 0)) AS is_received\r\n            , rc.last_receive_at::DATE AS received_date\r\n        FROM\r\n            tests.trans_purchase_detail AS pd\r\n            INNER JOIN tests.trans_purchase AS p\r\n                ON p.trans_purchase_id = pd.trans_purchase_id\r\n                AND p.remove IS FALSE\r\n            INNER JOIN tests.mstr_stakeholder AS s\r\n                ON s.mstr_stakeholder_id = p.stakeholder_id\r\n                AND s.remove IS FALSE\r\n            INNER JOIN tests.mstr_item AS i\r\n                ON i.mstr_item_id = pd.item_id\r\n                AND i.remove IS FALSE\r\n            INNER JOIN tests.mstr_item_kind AS k\r\n                ON k.mstr_item_kind_id = i.mstr_item_kind_id\r\n                AND k.remove IS FALSE\r\n            LEFT JOIN LATERAL (\r\n                SELECT\r\n                    ARRAY_AGG(ip.mstr_item_provision_id ORDER BY ip.mstr_item_provision_id) AS mstr_item_provision_ids\r\n                FROM\r\n                    tests.mstr_item_provision AS ip\r\n                    INNER JOIN tests.info_provision AS pv\r\n                        ON pv.info_provision_id = ip.info_provision_id\r\n                        AND pv.remove IS FALSE\r\n                WHERE\r\n                    ip.mstr_item_id = i.mstr_item_id\r\n                    AND ip.remove IS FALSE\r\n            ) AS pr\r\n                ON TRUE\r\n            LEFT JOIN LATERAL (\r\n                SELECT\r\n                    SUM(r.quantity) AS received_quantity\r\n                    , MAX(r.receive_at) AS last_receive_at\r\n                FROM\r\n                    tests.trans_purchase_rec AS r\r\n                WHERE\r\n                    r.trans_purchase_detail_id = pd.trans_purchase_detail_id\r\n                    AND r.remove IS FALSE\r\n            ) AS rc\r\n                ON TRUE\r\n        WHERE\r\n            pd.remove IS FALSE\r\n    ) AS x\r\nGROUP BY\r\n    x.supplier_id\r\n    , x.mstr_item_kind_id\r\n    , x.mstr_item_id\r\n    , x.mstr_item_provision_ids\r\n    , x.period\r\n    , x.is_received",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3886,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_staff_effective_access_path",
      "comment": "@primaryKey info_staff_id,info_access_path_id\n@foreignKey (info_staff_id) references info_staff (info_staff_id)\n@foreignKey (info_access_path_id) references info_access_path (info_access_path_id)\n@foreignKey (info_app_id) references info_app (info_app_id)\n担当者の実効アクセスパス(所属部署から継承した権限＋担当者ごとの許可)",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "WITH src AS (\r\n    -- 所属部署から継承 (有効な所属のみ。上位部署からは継承しない) : 読み取り + 書き込みフラグ\r\n    SELECT a.info_staff_id, d.info_access_path_id, COALESCE(d.write, FALSE) AS can_write, TRUE AS from_department, FALSE AS from_staff\r\n    FROM tests.info_assign AS a\r\n    INNER JOIN tests.info_department AS dp\r\n        ON dp.info_department_id = a.info_department_id AND dp.remove IS FALSE\r\n    INNER JOIN tests.info_department_access_path AS d\r\n        ON d.info_department_id = a.info_department_id AND d.remove IS FALSE\r\n    WHERE a.enable IS TRUE AND a.remove IS FALSE\r\n    UNION ALL\r\n    -- 担当者ごとの許可 : 読み取り + 書き込みフラグ\r\n    SELECT p.info_staff_id, p.info_access_path_id, COALESCE(p.write, FALSE), FALSE, TRUE\r\n    FROM tests.info_staff_access_permission AS p\r\n    WHERE p.remove IS FALSE\r\n)\r\nSELECT\r\n    s.info_staff_id\r\n    , st.symbol AS staff_symbol\r\n    , st.code AS staff_code\r\n    , s.info_access_path_id\r\n    , ap.symbol AS access_path_symbol\r\n    , ap.usecase_path\r\n    , ap.info_app_id\r\n    , BOOL_OR(s.can_write) AS can_write\r\n    , BOOL_OR(s.from_department) AS from_department\r\n    , BOOL_OR(s.from_staff) AS from_staff\r\nFROM src AS s\r\nINNER JOIN tests.info_staff AS st ON st.info_staff_id = s.info_staff_id AND st.remove IS FALSE\r\nINNER JOIN tests.info_access_path AS ap ON ap.info_access_path_id = s.info_access_path_id AND ap.remove IS FALSE\r\nGROUP BY s.info_staff_id, st.symbol, st.code, s.info_access_path_id, ap.symbol, ap.usecase_path, ap.info_app_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3887,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_purchase_amount",
      "comment": "@foreignKey (supplier_id) references mstr_stakeholder (mstr_stakeholder_id)\n@foreignKey (mstr_item_kind_id) references mstr_item_kind (mstr_item_kind_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n発注金額合計",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    p.stakeholder_id AS supplier_id\r\n    , i.mstr_item_kind_id\r\n    , i.mstr_item_id\r\n    , pr.mstr_item_provision_ids\r\n    , pd.period::DATE AS period\r\n    , (COALESCE(rc.received_quantity, 0) >= COALESCE(pd.quantity, 0)) AS is_received\r\n    , COUNT(pd.trans_purchase_detail_id) AS purchase_detail_count\r\n    , SUM(COALESCE(pd.quantity, 0)) AS purchase_quantity\r\n    , SUM(COALESCE(rc.received_quantity, 0)) AS received_quantity\r\n    , SUM(COALESCE(pd.quantity, 0) * COALESCE(pd.fixed_price, pd.unit_price, 0) + COALESCE(pd.price_adjustment, 0)) AS purchase_amount\r\n    , ROUND(SUM((COALESCE(rc.received_quantity, 0)) * COALESCE(pd.fixed_price, pd.unit_price, 0) + COALESCE(pd.price_adjustment, 0) * COALESCE((COALESCE(rc.received_quantity, 0)) / NULLIF(pd.quantity, 0), 0)), 2) AS received_amount\r\nFROM\r\n    tests.trans_purchase_detail AS pd\r\n    INNER JOIN tests.trans_purchase AS p\r\n        ON p.trans_purchase_id = pd.trans_purchase_id\r\n        AND p.remove IS FALSE\r\n    INNER JOIN tests.mstr_stakeholder AS s\r\n        ON s.mstr_stakeholder_id = p.stakeholder_id\r\n        AND s.remove IS FALSE\r\n    INNER JOIN tests.mstr_item AS i\r\n        ON i.mstr_item_id = pd.item_id\r\n        AND i.remove IS FALSE\r\n    INNER JOIN tests.mstr_item_kind AS k\r\n        ON k.mstr_item_kind_id = i.mstr_item_kind_id\r\n        AND k.remove IS FALSE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            ARRAY_AGG(ip.mstr_item_provision_id ORDER BY ip.mstr_item_provision_id) AS mstr_item_provision_ids\r\n        FROM\r\n            tests.mstr_item_provision AS ip\r\n            INNER JOIN tests.info_provision AS pv\r\n                ON pv.info_provision_id = ip.info_provision_id\r\n                AND pv.remove IS FALSE\r\n        WHERE\r\n            ip.mstr_item_id = i.mstr_item_id\r\n            AND ip.remove IS FALSE\r\n    ) AS pr\r\n        ON TRUE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            SUM(r.quantity) AS received_quantity\r\n        FROM\r\n            tests.trans_purchase_rec AS r\r\n        WHERE\r\n            r.trans_purchase_detail_id = pd.trans_purchase_detail_id\r\n            AND r.remove IS FALSE\r\n    ) AS rc\r\n        ON TRUE\r\nWHERE\r\n    pd.remove IS FALSE\r\nGROUP BY\r\n    p.stakeholder_id\r\n    , i.mstr_item_kind_id\r\n    , i.mstr_item_id\r\n    , pr.mstr_item_provision_ids\r\n    , pd.period::DATE\r\n    , (COALESCE(rc.received_quantity, 0) >= COALESCE(pd.quantity, 0))",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3888,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_sales_record",
      "comment": "@foreignKey (customer_id) references mstr_stakeholder (mstr_stakeholder_id)\n@foreignKey (mstr_item_kind_id) references mstr_item_kind (mstr_item_kind_id)\n@foreignKey (mstr_item_id) references mstr_item (mstr_item_id)\n売り上げ実績",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    o.stakeholder_id AS customer_id\r\n    , i.mstr_item_kind_id\r\n    , i.mstr_item_id\r\n    , pr.mstr_item_provision_ids\r\n    , COALESCE(od.delivery_date, o.delivery_date)::DATE AS delivery_date\r\n    , (COALESCE(sh.shipped_quantity, 0) >= od.quantity - od.cancel_quantity) AS is_shipped\r\n    , COUNT(od.trans_order_detail_id) AS order_detail_count\r\n    , SUM(od.quantity - od.cancel_quantity) AS order_quantity\r\n    , SUM(od.cancel_quantity) AS cancel_quantity\r\n    , SUM(COALESCE(sh.shipped_quantity, 0)) AS shipped_quantity\r\n    , SUM(COALESCE(od.quantity - od.cancel_quantity, 0) * COALESCE(od.fixed_price, od.unit_price, 0) + COALESCE(od.price_adjustment, 0)) AS order_amount\r\n    , ROUND(SUM((COALESCE(sh.shipped_quantity, 0)) * COALESCE(od.fixed_price, od.unit_price, 0) + COALESCE(od.price_adjustment, 0) * COALESCE((COALESCE(sh.shipped_quantity, 0)) / NULLIF(od.quantity - od.cancel_quantity, 0), 0)), 2) AS shipped_amount\r\n    , SUM(COALESCE(st.settlement_amount, 0)) AS settlement_amount\r\n    , SUM(COALESCE(od.quantity - od.cancel_quantity, 0) * COALESCE(od.fixed_price, od.unit_price, 0) + COALESCE(od.price_adjustment, 0)\r\n          + COALESCE(st.settlement_amount, 0)) AS total_amount\r\nFROM\r\n    tests.trans_order_detail AS od\r\n    INNER JOIN tests.trans_order AS o\r\n        ON o.trans_order_id = od.trans_order_id\r\n        AND o.remove IS FALSE\r\n    INNER JOIN tests.mstr_stakeholder AS c\r\n        ON c.mstr_stakeholder_id = o.stakeholder_id\r\n        AND c.remove IS FALSE\r\n    INNER JOIN tests.mstr_item AS i\r\n        ON i.mstr_item_id = od.item_id\r\n        AND i.remove IS FALSE\r\n    INNER JOIN tests.mstr_item_kind AS k\r\n        ON k.mstr_item_kind_id = i.mstr_item_kind_id\r\n        AND k.remove IS FALSE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            ARRAY_AGG(ip.mstr_item_provision_id ORDER BY ip.mstr_item_provision_id) AS mstr_item_provision_ids\r\n        FROM\r\n            tests.mstr_item_provision AS ip\r\n            INNER JOIN tests.info_provision AS pv\r\n                ON pv.info_provision_id = ip.info_provision_id\r\n                AND pv.remove IS FALSE\r\n        WHERE\r\n            ip.mstr_item_id = i.mstr_item_id\r\n            AND ip.remove IS FALSE\r\n    ) AS pr\r\n        ON TRUE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            SUM(r.shipping_quantity) AS shipped_quantity\r\n        FROM\r\n            tests.trans_shipping_order_detail AS sd\r\n            INNER JOIN tests.trans_shipping_order AS so\r\n                ON so.trans_shipping_order_id = sd.trans_shipping_order_id\r\n                AND so.remove IS FALSE\r\n            INNER JOIN tests.trans_shipping_order_detail_record AS r\r\n                ON r.trans_shipping_order_detail_id = sd.trans_shipping_order_detail_id\r\n                AND r.remove IS FALSE\r\n        WHERE\r\n            sd.trans_order_detail_id = od.trans_order_detail_id\r\n            AND sd.remove IS FALSE\r\n    ) AS sh\r\n        ON TRUE\r\n    LEFT JOIN LATERAL (\r\n        SELECT\r\n            SUM(s.amount) AS settlement_amount\r\n        FROM\r\n            tests.trans_order_detail_settlement AS s\r\n        WHERE\r\n            s.trans_order_detail_id = od.trans_order_detail_id\r\n            AND s.remove IS FALSE\r\n    ) AS st\r\n        ON TRUE\r\nWHERE\r\n    od.remove IS FALSE\r\nGROUP BY\r\n    o.stakeholder_id\r\n    , i.mstr_item_kind_id\r\n    , i.mstr_item_id\r\n    , pr.mstr_item_provision_ids\r\n    , COALESCE(od.delivery_date, o.delivery_date)::DATE\r\n    , (COALESCE(sh.shipped_quantity, 0) >= od.quantity - od.cancel_quantity)",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3889,
      "kind": "view",
      "logicalName": "",
      "physicalName": "v_staff_count",
      "comment": "@foreignKey (info_company_id) references info_company (info_company_id)\n@foreignKey (info_department_id) references info_department (info_department_id)\n@foreignKey (info_position_id) references info_position (info_position_id)\n@primaryKey info_department_id,info_position_id\n従業員数",
      "locked": false,
      "viewType": "sql",
      "join": {
        "sources": [],
        "columns": [],
        "where": ""
      },
      "function": {
        "methodId": null,
        "args": [],
        "columns": []
      },
      "sql": {
        "sql": "SELECT\r\n    d.info_company_id\r\n    , a.info_department_id\r\n    , a.info_position_id\r\n    , COUNT(DISTINCT a.info_staff_id) AS staff_count\r\n    , COUNT(a.info_assign_id) AS assign_count\r\nFROM\r\n    tests.info_assign AS a\r\n    INNER JOIN tests.info_staff AS s\r\n        ON s.info_staff_id = a.info_staff_id\r\n        AND s.remove IS FALSE\r\n    INNER JOIN tests.info_department AS d\r\n        ON d.info_department_id = a.info_department_id\r\n        AND d.remove IS FALSE\r\n    INNER JOIN tests.info_position AS p\r\n        ON p.info_position_id = a.info_position_id\r\n        AND p.remove IS FALSE\r\nWHERE\r\n    a.remove IS FALSE\r\n    AND a.enable IS TRUE\r\nGROUP BY\r\n    d.info_company_id\r\n    , a.info_department_id\r\n    , a.info_position_id",
        "columns": []
      },
      "preQuery": "",
      "postQuery": ""
    },
    {
      "id": 3890,
      "kind": "view",
