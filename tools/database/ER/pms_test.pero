    },
    {
      "id": 4164,
      "kind": "function",
      "name": "mrp_start_time",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_start_time(p_equipment uuid, p_date date) RETURNS time AS $$\r\n    SELECT COALESCE(\r\n        (SELECT c.start_time FROM tests.mstr_work_calendar AS c\r\n          WHERE p_equipment IS NOT NULL AND c.mstr_equipment_id = p_equipment AND c.work_date = p_date AND c.remove IS FALSE LIMIT 1),\r\n        (SELECT c.start_time FROM tests.mstr_work_calendar AS c\r\n          WHERE c.mstr_equipment_id IS NULL AND c.work_date = p_date AND c.remove IS FALSE LIMIT 1),\r\n        TIME '08:00');\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, date",
      "dependsOnTableIds": [
        395
      ],
      "schema": ""
    },
    {
      "id": 4165,
      "kind": "function",
      "name": "mrp_workday_add",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_workday_add(p_date date, p_days integer) RETURNS date AS $$\r\nDECLARE\r\n    d date := p_date;\r\n    n integer := abs(p_days);\r\n    step integer := CASE WHEN p_days < 0 THEN -1 ELSE 1 END;\r\n    guard integer := 0;\r\nBEGIN\r\n    WHILE n > 0 LOOP\r\n        d := d + step;\r\n        IF tests.mrp_capacity(NULL, d) > 0 THEN n := n - 1; END IF;\r\n        guard := guard + 1;\r\n        IF guard > 3660 THEN RAISE EXCEPTION 'mrp_workday_add: 稼働日が見つかりません'; END IF;\r\n    END LOOP;\r\n    RETURN d;\r\nEND\r\n$$ LANGUAGE plpgsql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "date, integer",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4166,
      "kind": "function",
      "name": "mrp_need_end",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_need_end(p_at timestamp) RETURNS timestamp AS $$\r\n    SELECT CASE WHEN p_at IS NULL THEN NULL\r\n                WHEN p_at::time = TIME '00:00' THEN p_at::date + INTERVAL '23:59:59'\r\n                ELSE p_at END;\r\n$$ LANGUAGE sql IMMUTABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "timestamp",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4167,
      "kind": "function",
      "name": "mrp_backward",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_backward(p_equipment uuid, p_end timestamp, p_hours numeric) RETURNS timestamp AS $$\r\nDECLARE\r\n    d date := p_end::date;\r\n    rem numeric := p_hours;\r\n    cap numeric; day_start timestamp; day_end timestamp; work_end timestamp; avail numeric;\r\n    guard integer := 0;\r\nBEGIN\r\n    IF rem IS NULL OR rem <= 0 THEN RETURN p_end; END IF;\r\n    LOOP\r\n        cap := tests.mrp_capacity(p_equipment, d);\r\n        IF cap > 0 THEN\r\n            day_start := d + tests.mrp_start_time(p_equipment, d);\r\n            day_end := day_start + make_interval(secs => (cap * 3600)::double precision);\r\n            work_end := LEAST(p_end, day_end);\r\n            avail := GREATEST(0, EXTRACT(EPOCH FROM (work_end - day_start)) / 3600);\r\n            IF avail > 0 AND rem <= avail THEN\r\n                RETURN work_end - make_interval(secs => (rem * 3600)::double precision);\r\n            END IF;\r\n            rem := rem - avail;\r\n        END IF;\r\n        d := d - 1;\r\n        guard := guard + 1;\r\n        IF guard > 3660 THEN RAISE EXCEPTION 'mrp_backward: 稼働日が見つかりません'; END IF;\r\n    END LOOP;\r\nEND\r\n$$ LANGUAGE plpgsql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, timestamp, numeric",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4168,
      "kind": "function",
      "name": "mrp_forward",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_forward(p_equipment uuid, p_start timestamp, p_hours numeric) RETURNS timestamp AS $$\r\nDECLARE\r\n    d date := p_start::date;\r\n    rem numeric := p_hours;\r\n    cap numeric; day_start timestamp; day_end timestamp; work_start timestamp; avail numeric;\r\n    guard integer := 0;\r\nBEGIN\r\n    IF rem IS NULL OR rem <= 0 THEN RETURN p_start; END IF;\r\n    LOOP\r\n        cap := tests.mrp_capacity(p_equipment, d);\r\n        IF cap > 0 THEN\r\n            day_start := d + tests.mrp_start_time(p_equipment, d);\r\n            day_end := day_start + make_interval(secs => (cap * 3600)::double precision);\r\n            work_start := GREATEST(p_start, day_start);\r\n            avail := GREATEST(0, EXTRACT(EPOCH FROM (day_end - work_start)) / 3600);\r\n            IF avail > 0 AND rem <= avail THEN\r\n                RETURN work_start + make_interval(secs => (rem * 3600)::double precision);\r\n            END IF;\r\n            rem := rem - avail;\r\n        END IF;\r\n        d := d + 1;\r\n        guard := guard + 1;\r\n        IF guard > 3660 THEN RAISE EXCEPTION 'mrp_forward: 稼働日が見つかりません'; END IF;\r\n    END LOOP;\r\nEND\r\n$$ LANGUAGE plpgsql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, timestamp, numeric",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4169,
      "kind": "function",
      "name": "mrp_spread",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_spread(p_equipment uuid, p_start timestamp, p_end timestamp)\r\nRETURNS TABLE (load_date date, hours numeric) AS $$\r\n    SELECT x.d::date,\r\n           GREATEST(0, EXTRACT(EPOCH FROM (\r\n               LEAST(p_end, x.ds + make_interval(secs => (x.cap * 3600)::double precision))\r\n             - GREATEST(p_start, x.ds))) / 3600)::numeric\r\n    FROM (\r\n        SELECT g.d, tests.mrp_capacity(p_equipment, g.d::date) AS cap,\r\n               g.d::date + tests.mrp_start_time(p_equipment, g.d::date) AS ds\r\n        FROM generate_series(p_start::date, p_end::date, INTERVAL '1 day') AS g(d)\r\n    ) AS x\r\n    WHERE x.cap > 0\r\n      AND LEAST(p_end, x.ds + make_interval(secs => (x.cap * 3600)::double precision)) > GREATEST(p_start, x.ds);\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, timestamp, timestamp",
      "dependsOnTableIds": [],
      "schema": ""
    },
    {
      "id": 4170,
      "kind": "function",
      "name": "mrp_proc_type",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_proc_type(p_item uuid) RETURNS smallint AS $$\r\n    SELECT CASE WHEN x.flag AND x.routing THEN 3\r\n                WHEN x.routing THEN 1\r\n                ELSE 2 END::smallint\r\n    FROM (\r\n        SELECT COALESCE(i.catalog_item, FALSE) AS flag,\r\n               EXISTS (SELECT 1 FROM tests.mstr_item_operation_task AS iot\r\n                       INNER JOIN tests.mstr_operation_task AS ot\r\n                           ON ot.mstr_operation_task_id = iot.mstr_operation_task_id AND ot.remove IS FALSE\r\n                       WHERE iot.mstr_item_id = i.mstr_item_id AND iot.remove IS FALSE) AS routing\r\n        FROM tests.mstr_item AS i WHERE i.mstr_item_id = p_item\r\n    ) AS x;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        2961,
        3241,
        3281
      ],
      "schema": ""
    },
    {
      "id": 4171,
      "kind": "function",
      "name": "mrp_suppliers",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_suppliers(p_item uuid)\r\nRETURNS TABLE (mstr_item_supplier_id uuid, mstr_stakeholder_id uuid, priority integer,\r\n               delivery_hours numeric, inspection_hours numeric, minimum_lot_size numeric,\r\n               cost numeric, asking_price boolean, supplier_item_code varchar) AS $$\r\n    SELECT ms.mstr_item_supplier_id, ms.mstr_stakeholder_id, COALESCE(ms.priority, 1),\r\n           EXTRACT(EPOCH FROM COALESCE(ms.delivery_time, INTERVAL '0')) / 3600,\r\n           EXTRACT(EPOCH FROM COALESCE(ms.quality_inspection_time, INTERVAL '0')) / 3600,\r\n           COALESCE(ms.minimum_lot_size, 0), ms.cost, COALESCE(ms.asking_price, FALSE), ms.supplier_item_code\r\n    FROM tests.mstr_item_supplier AS ms\r\n    INNER JOIN tests.mstr_stakeholder AS sh\r\n        ON sh.mstr_stakeholder_id = ms.mstr_stakeholder_id AND sh.remove IS FALSE AND sh.is_supplier IS TRUE\r\n    WHERE ms.mstr_item_id = p_item AND ms.remove IS FALSE\r\n    ORDER BY COALESCE(ms.priority, 1), ms.delivery_time, ms.cost;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        337,
        3378
      ],
      "schema": ""
    },
    {
      "id": 4172,
      "kind": "function",
      "name": "mrp_task_candidates",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_task_candidates(p_task uuid)\r\nRETURNS TABLE (mstr_task_location_id uuid, priority integer, kind smallint,\r\n               mstr_equipment_available_id uuid, mstr_equipment_id uuid,\r\n               mstr_outsource_available_id uuid, mstr_stakeholder_id uuid, delivery_hours numeric) AS $$\r\n    SELECT x.* FROM (\r\n        SELECT tl.mstr_task_location_id, COALESCE(tl.priority, 1), 1::smallint,\r\n               ea.mstr_equipment_available_id, ea.mstr_equipment_id, NULL::uuid, NULL::uuid,\r\n               EXTRACT(EPOCH FROM COALESCE(ea.delivery_interval, INTERVAL '0')) / 3600\r\n        FROM tests.mstr_task_location AS tl\r\n        INNER JOIN tests.mstr_equipment_available AS ea\r\n            ON ea.mstr_task_location_id = tl.mstr_task_location_id AND ea.remove IS FALSE\r\n        INNER JOIN tests.mstr_equipment AS e\r\n            ON e.mstr_equipment_id = ea.mstr_equipment_id AND e.remove IS FALSE\r\n        WHERE tl.mstr_task_id = p_task AND tl.remove IS FALSE\r\n        UNION ALL\r\n        SELECT tl.mstr_task_location_id, COALESCE(tl.priority, 1), 2::smallint,\r\n               NULL::uuid, NULL::uuid, oa.mstr_outsource_available_id, oa.mstr_stakeholder_id,\r\n               EXTRACT(EPOCH FROM COALESCE(oa.delivery_interval, INTERVAL '0')) / 3600\r\n        FROM tests.mstr_task_location AS tl\r\n        INNER JOIN tests.mstr_outsource_available AS oa\r\n            ON oa.mstr_task_location_id = tl.mstr_task_location_id AND oa.remove IS FALSE\r\n        INNER JOIN tests.mstr_stakeholder AS sh\r\n            ON sh.mstr_stakeholder_id = oa.mstr_stakeholder_id AND sh.remove IS FALSE\r\n        WHERE tl.mstr_task_id = p_task AND tl.remove IS FALSE\r\n    ) AS x (mstr_task_location_id, priority, kind, mstr_equipment_available_id, mstr_equipment_id,\r\n            mstr_outsource_available_id, mstr_stakeholder_id, delivery_hours)\r\n    ORDER BY x.priority, x.kind;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        1595,
        2176,
        2188,
        3346,
        3378
      ],
      "schema": ""
    },
    {
      "id": 4173,
      "kind": "function",
      "name": "mrp_task_cost",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_task_cost(p_item uuid, p_task_location uuid) RETURNS numeric AS $$\r\n    SELECT c.cost FROM tests.mstr_item_task_cost AS c\r\n    WHERE c.mstr_item_id = p_item AND c.mstr_task_location_id = p_task_location AND c.remove IS FALSE\r\n    ORDER BY c.update_at DESC LIMIT 1;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, uuid",
      "dependsOnTableIds": [
        368
      ],
      "schema": ""
    },
    {
      "id": 4174,
      "kind": "function",
      "name": "mrp_task_hours",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_task_hours(p_item uuid, p_task uuid) RETURNS numeric AS $$\r\n    SELECT COALESCE(\r\n        (SELECT EXTRACT(EPOCH FROM iot.default_interval) / 3600\r\n           FROM tests.mstr_item_operation_task AS iot\r\n           INNER JOIN tests.mstr_operation_task AS ot ON ot.mstr_operation_task_id = iot.mstr_operation_task_id\r\n          WHERE iot.mstr_item_id = p_item AND ot.mstr_task_id = p_task AND iot.remove IS FALSE\r\n            AND iot.default_interval IS NOT NULL\r\n          ORDER BY iot.sequence LIMIT 1),\r\n        (SELECT EXTRACT(EPOCH FROM t.default_time) / 3600 FROM tests.mstr_task AS t WHERE t.mstr_task_id = p_task),\r\n        0)::numeric;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, uuid",
      "dependsOnTableIds": [
        2961,
        3241,
        3316
      ],
      "schema": ""
    },
    {
      "id": 4175,
      "kind": "function",
      "name": "mrp_plan_task",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_plan_task(p_item uuid, p_task uuid, p_hours numeric, p_at timestamp,\r\n                                               p_backward boolean, p_fixed_ea uuid DEFAULT NULL, p_fixed_oa uuid DEFAULT NULL)\r\nRETURNS TABLE (kind smallint, mstr_task_location_id uuid, mstr_equipment_available_id uuid, mstr_equipment_id uuid,\r\n               mstr_outsource_available_id uuid, mstr_stakeholder_id uuid, cost numeric,\r\n               start_at timestamp, completion_at timestamp, ready_at timestamp,\r\n               alt_mstr_outsource_available_id uuid, alt_mstr_stakeholder_id uuid, alt_cost numeric) AS $$\r\nDECLARE\r\n    c record; b record; a record;\r\n    v_top integer;\r\n    v_st timestamp; v_en timestamp; v_rd timestamp; v_load numeric; v_del interval;\r\n    b_st timestamp; b_en timestamp; b_rd timestamp; b_load numeric; b_ok boolean := FALSE;\r\nBEGIN\r\n    p_hours := COALESCE(p_hours, 0);\r\n    -- 固定 (既存の生産計画明細)\r\n    IF p_fixed_oa IS NOT NULL THEN\r\n        SELECT oa.mstr_task_location_id AS tl, oa.mstr_stakeholder_id AS sh,\r\n               EXTRACT(EPOCH FROM COALESCE(oa.delivery_interval, INTERVAL '0')) / 3600 AS dh\r\n          INTO b FROM tests.mstr_outsource_available AS oa WHERE oa.mstr_outsource_available_id = p_fixed_oa;\r\n        v_del := make_interval(secs => (COALESCE(b.dh, 0) * 3600)::double precision);\r\n        IF p_backward THEN\r\n            v_rd := p_at; v_en := p_at - v_del; v_st := v_en - make_interval(secs => (p_hours * 3600)::double precision);\r\n        ELSE\r\n            v_st := p_at; v_en := p_at + make_interval(secs => (p_hours * 3600)::double precision); v_rd := v_en + v_del;\r\n        END IF;\r\n        RETURN QUERY SELECT 2::smallint, b.tl, NULL::uuid, NULL::uuid, p_fixed_oa, b.sh,\r\n                            tests.mrp_task_cost(p_item, b.tl), v_st, v_en, v_rd, NULL::uuid, NULL::uuid, NULL::numeric;\r\n        RETURN;\r\n    END IF;\r\n\r\n    SELECT MIN(x.priority) INTO v_top FROM tests.mrp_task_candidates(p_task) AS x;\r\n\r\n    -- 内部の候補 (固定があればその設備だけ)\r\n    FOR c IN\r\n        SELECT x.* FROM tests.mrp_task_candidates(p_task) AS x\r\n        WHERE x.kind = 1 AND p_fixed_ea IS NULL AND x.priority = v_top\r\n        UNION ALL\r\n        -- 固定: 工程計画で指定された利用可能設備をそのまま使う (工程の候補に無くても)\r\n        SELECT ea.mstr_task_location_id, 1, 1::smallint, ea.mstr_equipment_available_id, ea.mstr_equipment_id,\r\n               NULL::uuid, NULL::uuid, EXTRACT(EPOCH FROM COALESCE(ea.delivery_interval, INTERVAL '0')) / 3600\r\n        FROM tests.mstr_equipment_available AS ea\r\n        WHERE p_fixed_ea IS NOT NULL AND ea.mstr_equipment_available_id = p_fixed_ea\r\n    LOOP\r\n        v_del := make_interval(secs => (c.delivery_hours * 3600)::double precision);\r\n        IF p_backward THEN\r\n            v_rd := p_at; v_en := p_at - v_del;\r\n            v_st := tests.mrp_backward(c.mstr_equipment_id, v_en, p_hours);\r\n            v_en := LEAST(v_en, tests.mrp_forward(c.mstr_equipment_id, v_st, p_hours));\r\n        ELSE\r\n            v_st := p_at; v_en := tests.mrp_forward(c.mstr_equipment_id, p_at, p_hours); v_rd := v_en + v_del;\r\n        END IF;\r\n        SELECT COALESCE(SUM(dl.hours), 0) INTO v_load FROM _mrp_day AS dl\r\n        WHERE dl.equipment_id = c.mstr_equipment_id AND dl.planned AND dl.load_date BETWEEN v_st::date AND v_en::date;\r\n        IF NOT b_ok OR v_load < b_load\r\n           OR (v_load = b_load AND ((p_backward AND v_st > b_st) OR (NOT p_backward AND v_rd < b_rd))) THEN\r\n            b := c; b_st := v_st; b_en := v_en; b_rd := v_rd; b_load := v_load; b_ok := TRUE;\r\n        END IF;\r\n    END LOOP;\r\n\r\n    IF b_ok THEN\r\n        -- 外部にも出せるか (どの優先順でも)\r\n        SELECT x.mstr_outsource_available_id AS oa, x.mstr_stakeholder_id AS sh, tests.mrp_task_cost(p_item, x.mstr_task_location_id) AS cost\r\n          INTO a FROM tests.mrp_task_candidates(p_task) AS x\r\n         WHERE x.kind = 2\r\n         ORDER BY x.priority, x.delivery_hours, tests.mrp_task_cost(p_item, x.mstr_task_location_id) NULLS LAST LIMIT 1;\r\n        RETURN QUERY SELECT 1::smallint, b.mstr_task_location_id, b.mstr_equipment_available_id, b.mstr_equipment_id,\r\n                            NULL::uuid, NULL::uuid, tests.mrp_task_cost(p_item, b.mstr_task_location_id),\r\n                            b_st, b_en, b_rd, a.oa, a.sh, a.cost;\r\n        RETURN;\r\n    END IF;\r\n\r\n    -- 外部 (一番小さい priority の中で、デリバリー時間が短い → 単価が安い)\r\n    SELECT x.* INTO c FROM tests.mrp_task_candidates(p_task) AS x\r\n     WHERE x.kind = 2 AND x.priority = v_top\r\n     ORDER BY x.delivery_hours, tests.mrp_task_cost(p_item, x.mstr_task_location_id) NULLS LAST LIMIT 1;\r\n    IF FOUND THEN\r\n        v_del := make_interval(secs => (c.delivery_hours * 3600)::double precision);\r\n        IF p_backward THEN\r\n            v_rd := p_at; v_en := p_at - v_del; v_st := v_en - make_interval(secs => (p_hours * 3600)::double precision);\r\n        ELSE\r\n            v_st := p_at; v_en := p_at + make_interval(secs => (p_hours * 3600)::double precision); v_rd := v_en + v_del;\r\n        END IF;\r\n        RETURN QUERY SELECT 2::smallint, c.mstr_task_location_id, NULL::uuid, NULL::uuid,\r\n                            c.mstr_outsource_available_id, c.mstr_stakeholder_id,\r\n                            tests.mrp_task_cost(p_item, c.mstr_task_location_id),\r\n                            v_st, v_en, v_rd, NULL::uuid, NULL::uuid, NULL::numeric;\r\n        RETURN;\r\n    END IF;\r\n\r\n    -- 工程場所なし: 会社標準カレンダーで時間だけ計画 (負荷・外注発注は出ない)\r\n    IF p_backward THEN\r\n        v_rd := p_at; v_en := p_at; v_st := tests.mrp_backward(NULL, p_at, p_hours);\r\n    ELSE\r\n        v_st := p_at; v_en := tests.mrp_forward(NULL, p_at, p_hours); v_rd := v_en;\r\n    END IF;\r\n    RETURN QUERY SELECT 0::smallint, NULL::uuid, NULL::uuid, NULL::uuid, NULL::uuid, NULL::uuid, NULL::numeric,\r\n                        v_st, v_en, v_rd, NULL::uuid, NULL::uuid, NULL::numeric;\r\nEND\r\n$$ LANGUAGE plpgsql VOLATILE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid, uuid, numeric, timestamp, boolean, uuid, uuid",
      "dependsOnTableIds": [
        2176,
        2188
      ],
      "schema": ""
    },
    {
      "id": 4176,
      "kind": "function",
      "name": "mrp_issued",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_issued(p_rp uuid) RETURNS numeric AS $$\r\n    SELECT COALESCE(SUM(-v.quantity), 0)\r\n    FROM tests.trans_inventory_request AS rq\r\n    INNER JOIN tests.trans_inventory_apply AS ap\r\n        ON ap.trans_inventory_request_id = rq.trans_inventory_request_id AND ap.remove IS FALSE\r\n    INNER JOIN tests.trans_convey AS cv\r\n        ON cv.trans_convey_id = ap.convey_id AND cv.remove IS FALSE\r\n    INNER JOIN tests.trans_visiter AS v\r\n        ON v.trans_visiter_id = cv.trans_visiter_id AND v.remove IS FALSE\r\n       AND v.quantity < 0 AND v.adjustment IS NOT TRUE\r\n    WHERE rq.trans_resource_plan_id = p_rp AND rq.remove IS FALSE;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        2878,
        2924,
        2988,
        3141
      ],
      "schema": ""
    },
    {
      "id": 4177,
      "kind": "function",
      "name": "mrp_root_order_detail",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_root_order_detail(p_rp uuid) RETURNS uuid AS $$\r\nDECLARE r record; v_rp uuid := p_rp; v_guard integer := 0;\r\nBEGIN\r\n    WHILE v_rp IS NOT NULL AND v_guard < 30 LOOP\r\n        v_guard := v_guard + 1;\r\n        SELECT x.trans_order_detail_id, op.trans_resource_plan_id AS parent_rp INTO r\r\n        FROM tests.trans_resource_plan AS x\r\n        LEFT JOIN tests.trans_operations_plan AS op ON op.trans_operations_plan_id = x.parent_trans_operations_plan_id\r\n        WHERE x.trans_resource_plan_id = v_rp;\r\n        IF NOT FOUND THEN RETURN NULL; END IF;\r\n        IF r.trans_order_detail_id IS NOT NULL THEN RETURN r.trans_order_detail_id; END IF;\r\n        v_rp := r.parent_rp;\r\n    END LOOP;\r\n    RETURN NULL;\r\nEND\r\n$$ LANGUAGE plpgsql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        3173,
        3186
      ],
      "schema": ""
    },
    {
      "id": 4178,
      "kind": "function",
      "name": "mrp_op_frozen",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.mrp_op_frozen(p_op uuid) RETURNS boolean AS $$\r\n    SELECT COALESCE(op.stop, false)\r\n        OR COALESCE((SELECT od.stop FROM tests.trans_order_detail AS od\r\n                     WHERE od.trans_order_detail_id = tests.mrp_root_order_detail(op.trans_resource_plan_id)), false)\r\n    FROM tests.trans_operations_plan AS op WHERE op.trans_operations_plan_id = p_op;\r\n$$ LANGUAGE sql STABLE;",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "comment": "@omit",
      "args": "uuid",
      "dependsOnTableIds": [
        3077,
        3173
      ],
      "schema": ""
    },
