    {
      "id": 3825,
      "kind": "trigger",
      "name": "trg_02_history_mstr_item_tree",
      "external": false,
      "call": {
        "postgresql": "",
        "mysql": "",
        "sqlserver": "",
        "sqlite": ""
      },
      "bodies": {
        "postgresql": "CREATE OR REPLACE FUNCTION tests.trg_02_history_mstr_item_tree() RETURNS trigger AS\r\n$BODY$\r\nDECLARE\r\n    revisions int;\r\nBEGIN\r\n    IF (TG_OP = 'UPDATE') OR (TG_OP='INSERT') THEN\r\n        SELECT Max(revision) INTO revisions FROM tests.history_mstr_item_tree WHERE mstr_item_tree_id=NEW.mstr_item_tree_id;\r\n        IF (revisions >= 0) THEN\r\n            IF (\r\n                NEW.mstr_item_tree_id,\r\n                NEW.mstr_item_id,\r\n                NEW.parent_mstr_item_id,\r\n                NEW.code,\r\n                NEW.control_code,\r\n                NEW.names,\r\n                NEW.quantity,\r\n                NEW.details,\r\n                NEW.symbol,\r\n                NEW.remarks,\r\n                NEW.remove\r\n            ) IS NOT DISTINCT FROM (\r\n                OLD.mstr_item_tree_id,\r\n                OLD.mstr_item_id,\r\n                OLD.parent_mstr_item_id,\r\n                OLD.code,\r\n                OLD.control_code,\r\n                OLD.names,\r\n                OLD.quantity,\r\n                OLD.details,\r\n                OLD.symbol,\r\n                OLD.remarks,\r\n                OLD.remove\r\n            )\r\n            THEN\r\n                RETURN NULL;\r\n            END IF;\r\n            NEW.revision := revisions + 1;\r\n        ELSE\r\n            NEW.revision := 1;\r\n        END IF;\r\n        INSERT INTO tests.history_mstr_item_tree (\r\n            mstr_item_tree_id,\r\n            mstr_item_id,\r\n            parent_mstr_item_id,\r\n            code,\r\n            control_code,\r\n            names,\r\n            quantity,\r\n            details,\r\n            revision,\r\n            symbol,\r\n            remarks,\r\n            update_at,\r\n            update_user_id,\r\n            update_user_history_id,\r\n            remove\r\n        )\r\n        VALUES\r\n        (\r\n            NEW.mstr_item_tree_id,\r\n            NEW.mstr_item_id,\r\n            NEW.pare