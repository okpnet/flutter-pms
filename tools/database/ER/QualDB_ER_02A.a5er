[View]
PName=v_department_descendants
LName=組織子孫数
Comment=-- Postgraphile additional comment.\ncomment on view @schema.v_department_descendants is E\q@foreignKey (ancestor_info_department_id) references info_department (info_department_id)\\n@unique ancestor_info_department_id\q;
Query=SELECT\n    ancestor_info_department_id\n    , COUNT(descendant_info_department_id) AS descendant_count\nFROM\n    @schema.hrchy_info_department \nWHERE\n    remove = \qf\q \n    AND\n    ancestor_info_department_id <> descendant_info_department_id\nGROUP BY\n    ancestor_info_department_id
LNameByComment=1
Color=$000000
BkColor=$FFFFFF
Position="ビュー",150,100
ZOrder=1138
Page=ビュー
Left=150
Top=100

