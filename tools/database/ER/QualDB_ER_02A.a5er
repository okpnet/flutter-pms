Comment=-- Postgraphile additional comment.\ncomment on view @schema.v_operation_item_operation_count is E\q@foreignKey (mstr_operation_id) references mstr_operation (mstr_operation_id)\\n@unique mstr_operation_id\q;
Query=SELECT\n    p.mstr_operation_id\n    , COUNT(c.mstr_operation_id) AS all_count\n    , COUNT(c.mstr_operation_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\n    , COUNT(c.mstr_operation_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\nFROM\n    @schema.mstr_operation AS p\n    LEFT JOIN @schema.mstr_item_operation AS c\n        ON c.mstr_operation_id = p.mstr_operation_id\nGROUP BY\n    p.mstr_operation_id
LNameByComment=1
