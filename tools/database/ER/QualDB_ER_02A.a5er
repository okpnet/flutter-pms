Comment=-- Postgraphile additional comment.\ncomment on view @schema.v_order_order_detail_count is E\q@foreignKey (trans_order_id) references trans_order (trans_order_id)\\n@unique trans_order_id\q;
Query=SELECT\n    p.trans_order_id\n    , COUNT(c.trans_order_id) AS all_count\n    , COUNT(c.trans_order_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\n    , COUNT(c.trans_order_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\nFROM\n    @schema.trans_order AS p\n    LEFT JOIN @schema.trans_order_detail AS c\n        ON c.trans_order_id = p.trans_order_id\nGROUP BY\n    p.trans_order_id
LNameByComment=1
Color=$000000
BkColor=$FFFFFF
