[View]
PName=v_access_path_report_count
LName=アクセスパス－レポートマスタレコード数
Comment=-- Postgraphile additional comment.\ncomment on view @schema.v_access_path_report_count is E\q@foreignKey (info_access_path_id) references info_access_path (info_access_path_id)\\n@unique info_access_path_id\q;
Query=SELECT\n    p.info_access_path_id\n    , COUNT(c.info_access_path_id) AS all_count\n    , COUNT(c.info_access_path_id) FILTER (WHERE c.remove IS NOT TRUE) AS enable_count\n    , COUNT(c.info_access_path_id) FILTER (WHERE c.remove IS TRUE) AS disable_count\nFROM\n    @schema.info_access_path AS p\n    LEFT JOIN @schema.mstr_report AS c\n        ON c.info_access_path_id = p.info_access_path_id\nGROUP BY\n    p.info_access_path_id
LNameByComment=1
Color=$000000
BkColor=$FFFFFF
Position="ビュー",4950,750
ZOrder=1306
Page=ビュー
Left=4950
Top=750

