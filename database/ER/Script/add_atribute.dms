var frmER =(function(){
        var result=application.getActiveWindow();
        if (result.formType != "A5EREditor") {
            alert("アクティブウィンドウをERエディタにしてから実行してください。");
            exit();
        }
        return result;
    })();


var ext={
    "toFirst":function(array,func){
        for(var index in array){
            if(func(index,array[index]))return array[index];
        }
        return null;
      },
    "toWhere":function(array,func){//func->result bool,argment array[i]
        var result=new Array;
        for(var index in array){
            if(func(array[index]))result.add(array[index]);
        }
        return result;
        },
    "toAny":function(array,func){
        for(var index in array){
            if(func(array[index]))return true;
        }
        return false;
    },
    "toSelect":function(array,func){
        var result=new Array;
        for(var i in array){
            var funcResult=func(array[i]);
            if(funcResult != null)result.add(funcResult);
        }
        return result;
    },
    "tabs":function(e){
        var tabResults="";
        if(0>=e)return tabResults;
        for(var i=0;e>i;i++) tabResults+="    ";
        return tabResults;
    },
    "toFor":function(array,func){
        for(var i in array){
            var funcResult=func(i,array[i]);
        }
    }
};

var select=function(array,func){
        var result=new Array;
        for(var i in array){
            var funcResult=func(array[i]);
            if(funcResult != null)result.add(funcResult);
        }
        return result;
    };

///Historyテーブルにユニーク制約をつける
var addUniqToHistory=function(doc){
    //除くテーブルセット
    var entityArray=ext.toSelect(doc.objects,function(e){
        var reg=new RegExp("^history_");
        if(e.objectType=="Entity" && reg.test(e.pName))return e;
    });
    //shared_appellationsテーブルから生えているリレーションシップ
    var rels=ext.toSelect(doc.objects,function(e){
        var reg=new RegExp("^shared_appellations");
        if(e.objectType=="Relation"  &&  reg.test(e.entityPName1))return e;
    });
    ext.toFor(entityArray,function(index,entity){
        var indexCnt=entity.indexes.length;
        for(var i=0;i<indexCnt;i++){
            entity.indexes.delete(0);
        }
        var newIdx=entity.attributes[1].pName + "," + "revision";
        println(entity.pName + " " + newIdx);
        var uidx= entity.indexes.add();
        println(uidx.getKeys());
        uidx.attributes=newIdx;
        uidx.indexType=2;
    });
    println("Done!!");
};

//リレーションシップのモレチェック
var checkFromRel=function(doc){
    //shared_appellationsテーブルから生えているリレーションシップ
    var rels=ext.toSelect(doc.objects,function(e){
        var reg=new RegExp("^shared_appellations");
        if(e.objectType=="Relation")return e;
    });
    ext.toFor(rels,function(index,rel){
        if(rel.attributes1.length==0 || rel.attributes2.length==0){
            println("Entity: "+ rel.entityPName1 + " to " + rel.entityPName2);
        }
    });


    println("Done!!");
};

///Historyテーブルにユニーク制約をつける
//addUniqToHistory(frmER.document);
checkFromRel(frmER.document);