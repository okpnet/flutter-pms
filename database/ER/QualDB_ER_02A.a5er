Comment=
Query=SELECT\n    info_company.info_company_id\n    , info_company.name\n    , info_company.kana\n    , info_company.nickname\n    , info_company.ceo\n    , info_company.web_page\n    , info_address.info_address_id\n    , info_address.iso3166_3\n    , info_address.zip_code\n    , info_address.address1\n    , info_address.address2\n    , info_address.bill\n    , info_address.phone\n    , info_address.fax_number \nFROM\n    info_company \n    LEFT OUTER JOIN info_address \n        ON info_company.info_address_id = info_address.info_address_id\n    , history_info_staff\n
